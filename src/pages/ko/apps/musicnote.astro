---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppPage, { type Copy } from '../../../components/AppPage.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'ko/musicnote'))!;

const copy: Copy = {
  tagline: '세지 않고 읽게 되는 음표 연습',
  summary: '도에서부터 손가락으로 세던 자리가, 보는 순간 읽히는 자리가 됩니다.',
  hero: {
    iphone: '덧줄 위 라를 맞힌 순간 — 초록으로 채점된 답과 멈춘 시계 (iPhone)',
    ipad: '덧줄 위 라를 맞힌 순간 — 초록으로 채점된 답과 멈춘 시계 (iPad)',
  },
  tabs: { iphone: 'iPhone', ipad: 'iPad' },
  closing: ['기록도 계정도 기기 안에만 있습니다.', '로그인도, 서버로 나가는 것도 없어요.'],
  sections: [
    {
      label: 'Range',
      title: '범위를 좁혀서 시작하는 연습',
      lead: '넓게 시작한 연습은 대개 며칠 만에 지루해집니다. 높은음자리표와 낮은음자리표를 따로 켜고 끄고, 켠 쪽마다 덧줄을 어디까지 볼지 정합니다.',
      points: [
        '지금 필요한 음자리표만 켜 두니, 그쪽만 파고들게 돼요.',
        '덧줄을 어디까지 볼지 두 칸으로 정합니다. 덧줄 하나까지만, 아니면 셋까지. 아직 버거운 자리가 섞여 들지 않아요.',
        '고른 범위가 오선에 그대로 그려집니다. 시작하기 전에 판이 얼마나 넓은지 보여요.',
        '껐던 음자리표는 범위를 기억해 뒀다가 되돌려 줍니다. 매번 다시 고르지 않아요.',
      ],
      shots: {
        iphone: [
          { file: 'setup', alt: '켠 음자리표와 고른 범위가 오선에 그려진 테스트 탭' },
          { file: 'range', alt: '음자리표를 켜고 덧줄을 어디까지 볼지 고르는 출제 범위 시트' },
        ],
        ipad: [
          { file: 'setup', alt: 'iPad의 테스트 탭 — 켠 음자리표와 고른 범위가 오선에 그려진다' },
          { file: 'range', alt: 'iPad에서 음자리표와 덧줄 범위를 고르는 출제 범위 시트' },
        ],
      },
    },
    {
      label: 'Stages',
      title: '힌트를 한 칸씩 줄이는 다섯 단계',
      lead: '맨 악보부터 들이밀면 대부분 며칠 만에 그만둡니다. 연습 방식을 고르는 대신, 배우는 차례 한 줄에서 지금 자리를 고릅니다.',
      steps: [
        ['보기만', '앞의 두 단계는 묻지 않고 보여만 줍니다. 틀려 가며 배우는 대신 도에서 세는 길을 먼저 눈에 익혀요.'],
        ['힌트 줄이기', '그다음부터는 같은 음표를 묻되 힌트만 줄어듭니다. 사다리 전체에서 기준이 되는 도 하나로. 어제 보던 것을 오늘 답하게 돼요.'],
        ['계이름 적힌 길', '세는 길에는 자리마다 계이름이 적혀 있습니다. 어디서부터 어떻게 세는지 짐작할 일이 없어요.'],
        ['음표 하나', '마지막 단계에는 음표 하나만 남습니다. 준비가 됐는지 아닌지가 그 자리에서 드러나요.'],
      ],
      shots: {
        iphone: [
          { file: 'stages', alt: '보여만 주는 두 단계부터 힌트 없는 문제까지 다섯 칸이 한 줄로 선 연습 단계 시트' },
          { file: 'ladder-hint', alt: '도에서 문제 음까지 계이름이 적힌 사다리 힌트가 그려진 문제' },
        ],
        ipad: [
          { file: 'stages', alt: 'iPad의 연습 단계 시트 — 다섯 단계가 한 줄로 선다' },
          { file: 'ladder-hint', alt: 'iPad에서 사다리 힌트가 그려진 문제' },
        ],
      },
    },
    {
      label: 'Session',
      title: '길이를 정해 두고 시작하는 한 판',
      lead: '끝이 안 보이면 시작이 무겁고, 끝이 없으면 한 판을 끝냈다는 것도 남지 않습니다.',
      points: [
        '10·20·30·40·50 문제 중에 고릅니다. 오늘 낼 수 있는 시간만큼만 한 판이 돼요.',
        '끝을 두고 싶지 않은 날은 맨 뒤 칸이 받아 줍니다. 그만둘 때까지 그대로 이어져요.',
        '틀린 답은 목표를 깎지 않고 음표가 그대로 남습니다. 정답을 글자로 알려주지 않으니, 받아 적고 지나가는 대신 다시 읽게 돼요.',
        '다 맞히면 그 자리에서 판이 닫히고 기록이 남습니다. 어디서 멈출지 고민하지 않아요.',
      ],
      shots: {
        iphone: [
          { file: 'session-length', alt: '한 판의 문제 수를 고르는 시트 — 10문제부터 끝없이까지' },
          { file: 'hero', alt: '문제를 맞힌 순간 — 초록으로 채점된 답과 멈춘 시계' },
        ],
        ipad: [
          { file: 'session-length', alt: 'iPad에서 한 판의 문제 수를 고르는 시트' },
          { file: 'hero', alt: 'iPad에서 문제를 맞힌 순간' },
        ],
      },
    },
    {
      label: 'Stats',
      title: '음표 하나씩 따지는 성적',
      lead: '정답률 하나로는 무엇을 더 해야 할지 알 수 없습니다. 통계 탭은 음표 하나를 단위로 말합니다.',
      points: [
        '오선 지도 위에서 자리마다 색이 다릅니다. 어느 높이가 약한지 악보 모양 그대로 보여요.',
        '자리를 누르면 그 음표의 최근 다섯 문제와 걸린 시간 추이가 바로 아래에 섭니다.',
        '잘 맞힘과 헷갈림의 기준이 화면에 숫자로 적혀 있어요. 색을 짐작으로 읽지 않습니다.',
        '최근 스무 판만 셉니다. 몇 달 전에 못 읽던 것이 지금 성적에 남아 있지 않아요.',
      ],
      shots: {
        iphone: [{ file: 'stats-map', alt: '자리마다 초록·주황·빨강으로 칠해진 오선 지도와, 고른 음표의 최근 다섯 문제' }],
        ipad: [{ file: 'stats-map', alt: 'iPad의 오선 지도와 고른 음표의 성적표' }],
      },
    },
    {
      label: 'Records',
      title: '한 판이 한 줄로 남는 기록',
      lead: '늘었는지 아닌지는 느낌으로 알 수 없습니다. 기록 탭은 한 판을 한 줄로 남깁니다.',
      points: [
        '판마다 몇 개를 한 번에 맞혔고 얼마나 걸렸는지 한 줄로 남습니다. 지난 판과 그냥 비교돼요.',
        '줄을 열면 문제별로 걸린 시간까지 보입니다. 어느 음표가 시간을 먹었는지 짚여요.',
        '평균은 한 번에 맞힌 문제만 셉니다. 틀리고 고쳐 맞힌 것이 실력으로 잡히지 않아요.',
        '이름을 바꿔 가며 기록이 따로 쌓입니다. 한 기기를 여럿이 써도 성적이 섞이지 않아요.',
      ],
      shots: {
        iphone: [
          { file: 'sessions', alt: '날짜·유형·한 번에 맞힌 수·걸린 시간이 한 줄씩 쌓인 기록 탭' },
          { file: 'session-detail', alt: '한 판의 요약과 문제별 걸린 시간' },
          { file: 'save-account', alt: '판을 마치며 누구 기록으로 남길지 고르는 시트' },
        ],
        ipad: [
          { file: 'sessions', alt: 'iPad의 기록 탭' },
          { file: 'session-detail', alt: 'iPad에서 연 한 판의 요약과 문제별 풀이' },
          { file: 'save-account', alt: 'iPad에서 누구 기록으로 남길지 고르는 시트' },
        ],
      },
    },
  ],
};
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>
  <AppPage
    lang={lang}
    slug="musicnote"
    app={app}
    copy={copy}
    ipadShot="plain"
    shotSize={{ iphone: [720, 1564], ipad: [720, 960] }}
  />
</BaseLayout>
