---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppPage, { type Copy } from '../../../components/AppPage.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'ko/musicnote'))!;

const copy: Copy = {
  tagline: '세지 않고 읽게 되는 음표 연습',
  summary: '도에서부터 손가락으로 세던 자리가, 보는 순간 읽히는 자리가 됩니다.',
  hero: {
    iphone: '덧줄 위 라를 맞힌 순간 — 초록으로 채점된 답과 멈춘 문제 시계 (iPhone)',
    ipad: '덧줄 위 라를 맞힌 순간 — 초록으로 채점된 답과 멈춘 문제 시계 (iPad)',
  },
  tabs: { iphone: 'iPhone', ipad: 'iPad' },
  closing: ['기록도 계정도 기기 안에만 있습니다.', '로그인할 필요도 없어요.'],
  sections: [
    {
      label: 'Range',
      title: '범위를 좁혀서 시작하는 연습',
      lead: '넓게 시작한 연습은 대개 며칠 만에 지루해집니다. 높은음자리표와 낮은음자리표를 따로 켜고 끄고, 켠 쪽마다 덧줄을 어디까지 볼지 정합니다.',
      points: [
        '지금 필요한 음자리표만 켜 두니, 그쪽만 파고들게 돼요.',
        '덧줄은 쉬움(덧줄 1개)과 어려움(덧줄 3개) 두 단계로 정합니다. 아직 버거운 자리가 섞여 들지 않아요.',
        '고른 범위가 오선에 그대로 그려지고, 꺼 둔 음자리표도 흐리게 남아 있습니다. 켜기 전에 무엇을 고르게 되는지 보여요.',
        '맨 아래 집중 연습을 켜면 연습이 필요한 음표가 전체 문제의 60%로 나옵니다. 약한 자리를 따로 골라 담지 않아도 돼요.',
      ],
      shots: {
        iphone: [
          { file: 'setup', alt: '미리보기 오선 아래 출제 범위·연습 단계·문제 수가 한 카드에 선 테스트 설정' },
          { file: 'range', alt: '음자리표마다 출제하기 스위치와 쉬움·어려움 범위, 맨 아래 집중 연습이 있는 출제 범위 시트' },
        ],
        ipad: [
          { file: 'setup', alt: 'iPad의 테스트 설정 — 미리보기 오선과 고른 값 세 줄' },
          { file: 'range', alt: 'iPad에서 음자리표 범위와 집중 연습을 고르는 출제 범위 시트' },
        ],
      },
    },
    {
      label: 'Stages',
      title: '힌트를 한 칸씩 줄이는 다섯 단계',
      lead: '음표만 나열해서 들이밀면 대부분 며칠 만에 그만둡니다. 연습 방식을 고르는 대신, 배우는 차례 한 줄에서 지금 자리를 고릅니다. 단계 카드마다 예시가 직접 풀려서, 고르기 전에 무엇이 나오는지 보여요.',
      steps: [
        ['음계 익히기', '도에서 한 옥타브를 차례로 보여준 뒤 그중 한 음을 묻습니다. 나머지 음은 연하게 남아, 길을 보면서 답해요.'],
        ['도미솔·도라파', '기준 도에서 3도씩 쌓은 도·미·솔을, 낮은 자리에서는 도·라·파를 보여준 뒤 하나를 묻습니다. 한 칸씩 세지 않고 건너뛰는 길이 눈에 익어요.'],
        ['힌트 줄이기', '3단계는 연하게 깔린 음표 힌트를, 4단계는 기준 도 하나만 남깁니다. 어제 보던 길을 오늘은 스스로 짚게 돼요.'],
        ['힌트 없이', '마지막 단계에는 음표 하나만 남습니다. 그간 익힌 것이 읽히는지가 그 자리에서 드러나요.'],
      ],
      shots: {
        iphone: [
          { file: 'stages', alt: '음계 익히기부터 힌트 없이 풀기까지 다섯 단계가 예시 오선과 함께 선 연습 단계 시트' },
          { file: 'ladder-hint', alt: '음표 힌트로 풀기 단계 — 문제 음 아래로 도와 미가 연하게 깔린 문제' },
        ],
        ipad: [
          { file: 'stages', alt: 'iPad의 연습 단계 시트 — 다섯 단계와 예시 오선' },
          { file: 'ladder-hint', alt: 'iPad에서 음표 힌트가 연하게 깔린 문제' },
        ],
      },
    },
    {
      label: 'Session',
      title: '길이를 정해 두고 시작하는 한 판',
      lead: '끝이 안 보이면 시작이 무겁고, 끝이 없으면 한 판을 끝냈다는 것도 남지 않습니다.',
      points: [
        '10·20·30·40·50문제 중에 고릅니다. 끝을 두고 싶지 않은 날은 맨 뒤 제한 없음이 받아 줘요.',
        '맞히면 그 음의 높이로 소리가 나고, 틀리면 어떤 음도 내지 않습니다. 정답을 글자로 알려주지도 않으니, 받아 적고 지나가는 대신 다시 읽게 돼요.',
        '틀린 답은 목표를 깎지 않습니다. 맞힌 문제만 세요.',
        '목표를 채우면 기록 남기기 시트가 스스로 올라옵니다. 저장할 계정을 고르고 한 번 더를 누르면, 같은 설정으로 다음 판이 바로 시작돼요.',
      ],
      shots: {
        iphone: [
          { file: 'session-length', alt: '10문제부터 제한 없음까지 고르는 문제 수 시트' },
          { file: 'hero', alt: '문제를 맞힌 순간 — 초록으로 채점된 답과 진도 막대' },
          { file: 'save-account', alt: '기록 저장 스위치와 저장할 계정, 한 번 더 버튼이 있는 기록 남기기 시트' },
        ],
        ipad: [
          { file: 'session-length', alt: 'iPad에서 한 판의 문제 수를 고르는 시트' },
          { file: 'hero', alt: 'iPad에서 문제를 맞힌 순간' },
          { file: 'save-account', alt: 'iPad의 기록 남기기 시트' },
        ],
      },
    },
    {
      label: 'Stats',
      title: '음표마다 쌓이는 통계',
      lead: '정답률 하나로는 무엇을 더 해야 할지 알 수 없습니다. 통계 탭은 음표 하나를 단위로 말합니다.',
      points: [
        '오선 지도 위에서 자리마다 색이 다릅니다. 어느 높이가 약한지 악보 모양 그대로 보여요.',
        '음표를 누르면 아래 성적표가 그 음표로 바뀝니다. 정확도와 속도를 따로 판정하니, 맞히긴 하는데 느린 음표도 드러나요.',
        '판정 기준은 ? 를 누르면 숫자로 적혀 있습니다. 색을 짐작으로 읽지 않아요.',
        '지금 연습할 음표가 한 줄로 서고, 이 음표들로 연습을 누르면 그 음표 위주의 출제 범위가 바로 잡힙니다.',
        '최근 20회만 셉니다. 몇 달 전에 못 읽던 것이 지금 성적에 남아 있지 않아요.',
      ],
      shots: {
        iphone: [{ file: 'stats-map', alt: '자리마다 초록·주황·빨강으로 칠해진 오선 지도, 고른 음표의 정확도·속도 칩과 걸린 시간 추이, 지금 연습할 음표' }],
        ipad: [{ file: 'stats-map', alt: 'iPad의 오선 지도와 고른 음표의 성적표, 지금 연습할 음표' }],
      },
    },
    {
      label: 'Records',
      title: '한 판이 한 줄로 남는 기록',
      lead: '늘었는지 아닌지는 느낌으로 알 수 없습니다. 기록 탭은 날짜별로 한 판을 한 줄씩 남깁니다.',
      points: [
        '줄마다 시각과 걸린 시간, 유형, 그리고 오른쪽에 점수와 막대가 섭니다. 지난 판과 그냥 비교돼요.',
        '줄을 열면 문제별 풀이와 걸린 시간까지 보입니다. 어느 음표가 시간을 먹었는지 짚여요.',
        '동일한 유형 문제 다시 풀기를 누르면 그 판과 같은 설정으로 바로 다시 풉니다. 설정을 다시 맞추지 않아요.',
        '평균은 한 번에 맞힌 문제만 셉니다. 중간에 그만둔 판도 중단함 표시와 함께 남아요.',
        '이름별로 기록이 따로 쌓입니다. 한 기기를 여럿이 써도 성적이 섞이지 않아요.',
      ],
      shots: {
        iphone: [
          { file: 'sessions', alt: '날짜별로 묶여 시각·걸린 시간·유형·점수가 한 줄씩 쌓인 지난 기록' },
          { file: 'session-detail', alt: '테스트 결과 시트 — 요약, 동일한 유형 문제 다시 풀기, 문제별 풀이' },
        ],
        ipad: [
          { file: 'sessions', alt: 'iPad의 지난 기록' },
          { file: 'session-detail', alt: 'iPad에서 연 테스트 결과와 문제별 풀이' },
        ],
      },
    },
  ],
};
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>
  <AppPage
    lang={lang}
    slug="musicnote"
    app={app}
    copy={copy}
    ipadShot="plain"
    shotSize={{ iphone: [720, 1564], ipad: [720, 960] }}
  />
</BaseLayout>
