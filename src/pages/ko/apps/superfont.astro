---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppPage, { type Copy } from '../../../components/AppPage.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'ko/superfont'))!;

const copy: Copy = {
  tagline: '사둔 폰트를 쓰는 iPhone',
  summary: '받아 놓고 못 쓰던 폰트를 메모에서도, 문서에서도, 발표 자료에서도 쓰게 됩니다.',
  hero: {
    iphone: '설치된 폰트가 각자의 서체로 그려진 내 폰트 목록 (iPhone)',
    ipad: '설치된 폰트가 각자의 서체로 그려진 내 폰트 목록 (iPad)',
  },
  tabs: { iphone: 'iPhone', ipad: 'iPad' },
  closing: ['폰트 파일과 설치 기록은 기기 안에만 있습니다.', '계정도, 로그인도 없어요.'],
  sections: [
    {
      label: 'Import',
      title: '받은 파일을 받은 모양 그대로',
      lead: '폰트를 사거나 내려받아도 iPhone에서는 열어볼 방법조차 마땅치 않습니다. 맥을 거쳐 압축을 풀고 골라 오지 않아도, 내려받은 파일을 그대로 넣으면 됩니다.',
      steps: [
        ['ZIP 그대로', '압축을 풀지 않고 넣어도 안에 든 서체를 알아서 찾아냅니다. 파일 앱에서 한 번 풀고 다시 고르는 과정이 없어져요.'],
        ['중복 정리', '같은 서체가 TTF와 OTF 두 벌로 들어 있으면 하나만 남겨 줍니다. 같은 폰트를 두 번 설치해 목록이 지저분해지지 않아요.'],
        ['미리 걸러냄', '설치할 수 없는 파일은 이유와 함께 먼저 알려줍니다. 다 끝난 뒤에야 실패를 알게 되는 일이 없어요.'],
      ],
      shots: {
        iphone: [{ file: 'import', alt: 'ZIP 하나에서 찾아낸 13개 패밀리 17개 스타일' }],
        ipad: [{ file: 'import', alt: 'iPad에서 ZIP 하나를 불러온 파일 추가 화면' }],
      },
    },
    {
      label: 'Browse',
      title: '새 폰트를 찾는 시간도 앱 안에서',
      lead: '마음에 드는 폰트를 찾는 일은 대개 브라우저에서 시작해 파일 관리로 끝납니다. 내려받고, 압축을 풀고, 어디에 뒀는지 다시 찾는 과정이요. 그 과정을 앱 안으로 들여왔습니다.',
      points: [
        '무료로 쓸 수 있는 폰트 수천 개를 설치하는 자리에서 바로 넘겨 봅니다.',
        '손글씨체만, 고정폭만 하는 식으로 분류와 언어를 좁혀 볼 것을 줄여요.',
        '한글을 지원하는지 목록에서 바로 보여서, 막상 쓰려니 글자가 깨지는 일이 없습니다.',
        '마음에 든 폰트는 브라우저로 나가지 않고 그 자리에서 설치로 이어집니다.',
      ],
      shots: {
        iphone: [
          { file: 'browse', alt: '분류와 언어로 좁혀 본 무료 폰트 목록' },
          { file: 'browse-search', alt: '이름으로 검색해 고른 폰트와 한글 지원 표시' },
        ],
        ipad: [
          { file: 'browse', alt: 'iPad에서 분류로 좁혀 본 무료 폰트 목록' },
          { file: 'browse-search', alt: 'iPad에서 이름으로 검색해 고른 폰트' },
        ],
      },
    },
    {
      label: 'Preview',
      title: '설치하기 전에 눈으로 고릅니다',
      lead: '이름만 보고 고른 폰트는 문서에 넣어 보고 나서야 아니라는 걸 알게 되죠. 설치할 목록은 각 서체를 그 서체 자체로 그려서 보여줍니다.',
      points: [
        '크기를 밀어 보면 제목용으로 쓸 만한지, 본문에서도 읽히는지 그 자리에서 판단됩니다.',
        '미리보기 문구를 내가 쓰는 말로 바꾸면, 정작 필요한 글자가 빠진 폰트를 미리 알아챕니다.',
        '이미 설치된 서체는 설치됨으로 표시돼, 같은 걸 또 깔지 않아요.',
        '패밀리에서 필요한 굵기만 골라도 되고, 열 개가 넘어도 한 번에 묶입니다.',
      ],
      shots: {
        iphone: [{ file: 'preview', alt: '설치할 폰트를 각자의 서체로 미리 보는 선택 화면' }],
        ipad: [{ file: 'preview', alt: 'iPad에서 설치할 폰트를 미리 보는 선택 화면' }],
      },
    },
    {
      label: 'Profile',
      title: '프로파일을 직접 만들 필요가 없어요',
      lead: 'iOS는 앱이 시스템 폰트를 직접 설치하지 못하게 막아 두었습니다. 대신 구성 프로파일이라는 파일이 필요한데, 그건 보통 회사 기기를 관리하는 기술자가 손으로 만드는 물건이에요. 구조가 조금만 어긋나도 설치가 거부됩니다.',
      points: [
        '고른 서체가 담긴 프로파일이 알아서 만들어집니다. 파일 안쪽을 알 필요가 없어요.',
        '설정 앱에 표시될 이름이 미리 채워져 있어, 나중에 어떤 프로파일이었는지 헤매지 않습니다.',
        '여러 폰트가 하나로 묶여 한 번에 들어가요. 폰트마다 같은 과정을 반복하지 않습니다.',
      ],
      shots: {
        iphone: [{ file: 'profile', alt: '설치할 폰트와 프로파일 이름이 미리 채워진 다운로드 단계' }],
        ipad: [{ file: 'profile', alt: 'iPad의 프로파일 다운로드 단계' }],
      },
    },
    {
      label: 'Guide',
      title: '중간에 막혀서 포기하는 일이 없도록',
      lead: "설치는 Safari와 설정 앱을 오가는 낯선 길입니다. 게다가 도중에 '서명되지 않음' 경고까지 나와요. 여기서 그만두는 사람이 가장 많습니다.",
      steps: [
        ['화면 사진', '단계마다 실제 화면 사진을 보여줍니다. 지금 눌러야 할 버튼을 찾아 헤매지 않아요.'],
        ['경고 설명', '그 경고가 왜 정상인지 나타나는 그 자리에서 알려줍니다. 위험한 건 아닌지 망설이다 그만두지 않아요.'],
        ['자동 진행', '설정 앱에서 설치를 마치고 돌아오면 다음 단계로 저절로 넘어갑니다. 어디까지 했는지 기억할 필요가 없어요.'],
      ],
      shots: {
        iphone: [
          { file: 'guide-safari', alt: "Safari에서 '허용' 을 눌러야 할 자리를 실제 화면으로 보여주는 안내" },
          { file: 'guide-install', alt: '설정 앱에서 할 일 일곱 단계 목록' },
          { file: 'guide-settings', alt: "설정 앱의 '설치' 버튼 위치를 실제 화면으로 보여주는 안내" },
        ],
        ipad: [
          { file: 'guide-install', alt: 'iPad에서 설정 앱에서 할 일 목록' },
          { file: 'guide-settings', alt: "iPad에서 '설치' 버튼 위치를 보여주는 안내" },
        ],
      },
    },
    {
      label: 'My Fonts',
      title: '무엇이 깔려 있는지 아는 상태로',
      lead: '폰트는 한번 설치하고 나면 일주일 뒤에 무엇이 들어 있는지 아무도 기억하지 못합니다. 내 폰트 목록은 지금 상태를 짐작하지 않아도 되게 만들어요.',
      points: [
        '설치된 서체와 아직 아닌 것이 한 목록에서 구분됩니다.',
        '각 줄이 그 폰트 자체로 그려지니, 이름만 보고 생김새를 떠올릴 필요가 없어요.',
        '패밀리를 펼치면 어떤 굵기까지 들어와 있는지 보입니다.',
        '이름으로 검색하고 설치됨·미설치로 걸러내, 수십 개가 되어도 원하는 하나를 금방 집어냅니다.',
      ],
      shots: {
        iphone: [{ file: 'my-fonts', alt: '패밀리를 펼쳐 설치된 굵기까지 확인하는 내 폰트 목록' }],
        ipad: [{ file: 'my-fonts', alt: 'iPad의 내 폰트 목록' }],
      },
    },
    {
      label: 'Reinstall',
      title: '사라져도 다시 구하러 다니지 않게',
      lead: '기기를 초기화하거나 프로파일을 지우면 폰트도 함께 사라집니다. 원본 파일을 어디서 받았는지 기억나지 않는 건 그다음 일이죠.',
      points: [
        '설치했던 파일을 앱이 보관하고 있어, 사라진 것만 골라 한 번에 되돌립니다.',
        '필요 없어진 폰트는 같은 화면에서 골라 지웁니다.',
        '원본을 다시 구하거나, 어느 폴더에 뒀는지 기억해 낼 일이 없어요.',
      ],
      shots: {
        iphone: [{ file: 'reinstall', alt: '여러 폰트를 골라 한 번에 재설치하거나 지우는 화면' }],
        ipad: [{ file: 'reinstall', alt: 'iPad에서 여러 폰트를 골라 재설치하는 화면' }],
      },
    },
  ],
};

const footerLinks = [
  { href: '/ko/apps/superfont/support/', label: '지원' },
  { href: '/ko/apps/superfont/privacy/', label: '개인정보처리방침' },
];
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>
  <AppPage
    lang={lang}
    slug="superfont"
    app={app}
    copy={copy}
    ipadShot="plain"
    shotSize={{ iphone: [720, 1564], ipad: [720, 960] }}
    footerLinks={footerLinks}
  />
</BaseLayout>
