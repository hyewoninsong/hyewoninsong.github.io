---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'ko/superfont'))!;

const { platforms = {} } = app.data;

const badgeClass = (status: 'released' | 'in-development') =>
  status === 'released'
    ? 'border-green-200 bg-green-50 text-green-700'
    : 'border-border bg-muted text-muted-foreground';

const statusLabel = (status: 'released' | 'in-development') =>
  status === 'released' ? t('status.released') : t('status.dev');

const img = (name: string) => `/apps/superfont/ko/${name}.png`;
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>

  <style>
    .animate-reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .animate-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .delay-1 { transition-delay: 0.06s; }
    .delay-2 { transition-delay: 0.12s; }
    .delay-3 { transition-delay: 0.18s; }

    .screenshot {
      border-radius: 2.5rem;
      box-shadow: 0 20px 60px rgba(0,0,0,0.12), 0 4px 16px rgba(0,0,0,0.08);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      display: block;
    }
    .screenshot:hover {
      transform: scale(1.02) translateY(-2px);
      box-shadow: 0 28px 72px rgba(0,0,0,0.16), 0 6px 20px rgba(0,0,0,0.1);
    }

    .section-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-primary);
      margin-bottom: 0.75rem;
    }

    .step-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }
    .step-list li {
      display: flex;
      gap: 0.75rem;
      font-size: 0.875rem;
      color: var(--color-text-sub);
      line-height: 1.6;
    }
    .step-list li span:first-child {
      flex-shrink: 0;
      font-weight: 600;
      color: var(--color-text);
      min-width: 5.5rem;
    }

    .point-list {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin-top: 1.25rem;
    }
    .point-list li {
      position: relative;
      padding-left: 1.1rem;
      font-size: 0.875rem;
      color: var(--color-text-sub);
      line-height: 1.6;
    }
    .point-list li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.7rem;
      width: 0.35rem;
      height: 0.35rem;
      border-radius: 9999px;
      background: var(--color-primary);
    }

    .mini-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .mini-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.08);
    }
  </style>

  <div class="max-w-5xl w-full mx-auto px-6 py-24 md:py-36">

    <!-- ── Header ── -->
    <div class="text-center mb-20 md:mb-28 animate-reveal">
      <h1 class="text-3xl md:text-4xl font-semibold text-text tracking-tight mb-3">{app.data.title}</h1>
      <p class="text-lg text-text font-medium mb-3">사둔 폰트를 쓰는 iPhone</p>
      <p class="text-base text-text-sub mb-6 max-w-md mx-auto leading-relaxed">
        받아 놓고 못 쓰던 폰트를 메모에서도, 문서에서도, 발표 자료에서도 쓰게 됩니다.
      </p>

      {(platforms.iphone || platforms.ipad) && (
        <div class="flex items-center gap-2 flex-wrap justify-center">
          <span class="flex items-center gap-1 text-xs text-text-sub shrink-0">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 shrink-0">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            iOS
          </span>
          <div class="flex gap-1.5 flex-wrap justify-center">
            {platforms.iphone && (
              <span class:list={['inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-medium', badgeClass(platforms.iphone)]}>
                iPhone · {statusLabel(platforms.iphone)}
              </span>
            )}
            {platforms.ipad && (
              <span class:list={['inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-medium', badgeClass(platforms.ipad)]}>
                iPad · {statusLabel(platforms.ipad)}
              </span>
            )}
          </div>
        </div>
      )}

      {app.data.appStoreUrl && (
        <div>
          <a href={app.data.appStoreUrl} target="_blank" rel="noopener noreferrer"
             class="inline-block mt-6 text-sm text-primary hover:underline">
            App Store →
          </a>
        </div>
      )}
    </div>

    <!-- ── Intro screenshot ── -->
    <div class="flex justify-center mb-28 animate-reveal delay-1">
      <img
        src={img('my-fonts')}
        alt="설치된 폰트가 각자의 서체로 그려진 내 폰트 목록"
        class="screenshot w-full max-w-[300px]"
        width="1090" height="2079"
      />
    </div>

  </div>

  <!-- ── Section: Import ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-16">
      <div class="flex-1 min-w-0 animate-reveal">
        <span class="section-label">Import</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">받은 파일을 받은 모양 그대로</h2>
        <p class="text-text-sub leading-relaxed">
          폰트를 사거나 내려받아도 iPhone에서는 열어볼 방법조차 마땅치 않습니다.
          맥을 거쳐 압축을 풀고 골라 오지 않아도, 내려받은 파일을 그대로 넣으면 됩니다.
        </p>
        <ul class="step-list">
          <li><span>ZIP 그대로</span><span>압축을 풀지 않고 넣어도 안에 든 서체를 알아서 찾아냅니다. 파일 앱에서 한 번 풀고 다시 고르는 과정이 없어져요.</span></li>
          <li><span>중복 정리</span><span>같은 서체가 TTF와 OTF 두 벌로 들어 있으면 하나만 남겨 줍니다. 같은 폰트를 두 번 설치해 목록이 지저분해지지 않아요.</span></li>
          <li><span>미리 걸러냄</span><span>설치할 수 없는 파일은 이유와 함께 먼저 알려줍니다. 다 끝난 뒤에야 실패를 알게 되는 일이 없어요.</span></li>
        </ul>
      </div>
      <div class="flex-1 min-w-0 flex justify-center animate-reveal delay-1">
        <img
          src={img('import')}
          alt="ZIP 하나에서 찾아낸 13개 패밀리 17개 스타일"
          class="screenshot w-full max-w-[280px]"
          width="1090" height="2079" loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ── Section: Browse ── -->
  <section class="py-24 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="flex-1 min-w-0 animate-reveal">
        <span class="section-label">Browse</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">새 폰트를 찾는 시간도 앱 안에서</h2>
        <p class="text-text-sub leading-relaxed">
          마음에 드는 폰트를 찾는 일은 대개 브라우저에서 시작해 파일 관리로 끝납니다.
          내려받고, 압축을 풀고, 어디에 뒀는지 다시 찾는 과정이요. 그 과정을 앱 안으로 들여왔습니다.
        </p>
        <ul class="point-list">
          <li>무료로 쓸 수 있는 폰트 수천 개를 앱 안에서 바로 넘겨 봅니다.</li>
          <li>손글씨체만, 고정폭만 하는 식으로 분류와 언어를 좁혀 찾는 시간을 줄여요.</li>
          <li>한글을 지원하는지 목록에서 바로 보여서, 막상 쓰려니 글자가 깨지는 일이 없습니다.</li>
          <li>마음에 든 폰트는 브라우저로 나가지 않고 그 자리에서 설치로 이어집니다.</li>
        </ul>
      </div>
      <div class="flex-1 min-w-0 flex justify-center animate-reveal delay-1">
        <img
          src={img('google-fonts')}
          alt="분류와 언어로 좁혀 본 무료 폰트 목록"
          class="screenshot w-full max-w-[280px]"
          width="1090" height="2079" loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ── Section: Install ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-16">
      <div class="flex-1 min-w-0 animate-reveal">
        <span class="section-label">Install</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">프로파일을 직접 만들 필요가 없어요</h2>
        <p class="text-text-sub leading-relaxed">
          iOS는 앱이 시스템 폰트를 직접 설치하지 못하게 막아 두었습니다. 대신 구성 프로파일이라는 파일이 필요한데,
          그건 보통 회사 기기를 관리하는 기술자가 손으로 만드는 물건이에요. 구조가 조금만 어긋나도 설치가 거부됩니다.
          SuperFont가 그 파일을 대신 만들고, 설치가 끝날 때까지 길을 안내합니다.
        </p>
        <ul class="step-list">
          <li><span>자동 생성</span><span>고른 서체가 담긴 프로파일이 알아서 만들어집니다. 설정 앱에 표시될 이름까지 미리 채워져 있어, 나중에 어떤 프로파일이었는지 헤매지 않아요.</span></li>
          <li><span>한 번에 묶어</span><span>여러 폰트가 하나의 프로파일로 들어갑니다. 폰트마다 같은 과정을 반복하지 않아요.</span></li>
          <li><span>화면 사진</span><span>Safari와 설정 앱을 오가는 단계마다 실제 화면 사진을 보여줍니다. 지금 눌러야 할 버튼을 찾아 헤매지 않아요.</span></li>
          <li><span>경고 설명</span><span>도중에 나오는 '서명되지 않음' 경고가 왜 정상인지 그 자리에서 알려줍니다. 위험한 건 아닌지 망설이다 그만두지 않아요.</span></li>
          <li><span>자동 진행</span><span>설정 앱에서 설치를 마치고 돌아오면 다음 단계로 저절로 넘어갑니다. 어디까지 했는지 기억할 필요가 없어요.</span></li>
        </ul>
      </div>
      <div class="flex-1 min-w-0 flex justify-center animate-reveal delay-1">
        <img
          src={img('profile')}
          alt="설치할 폰트와 프로파일 이름이 미리 채워진 다운로드 단계"
          class="screenshot w-full max-w-[280px]"
          width="1090" height="2079" loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ── Section: My Fonts ── -->
  <section class="py-24 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="flex-1 min-w-0 animate-reveal">
        <span class="section-label">My Fonts</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">무엇이 깔려 있는지 아는 상태로</h2>
        <p class="text-text-sub leading-relaxed">
          폰트는 한번 설치하고 나면 일주일 뒤에 무엇이 들어 있는지 아무도 기억하지 못합니다.
          내 폰트 목록은 지금 상태를 짐작하지 않아도 되게 만들어요.
        </p>
        <ul class="point-list">
          <li>설치된 서체와 아직 아닌 것이 한 목록에서 구분됩니다.</li>
          <li>각 줄은 그 폰트 자체로 그려지니, 이름만 보고 생김새를 떠올릴 필요가 없어요.</li>
          <li>크기를 밀어 보면 제목용으로 쓸 만한지, 본문에서도 읽히는지 그 자리에서 판단됩니다.</li>
          <li>미리보기 문구를 내가 쓰는 말로 바꾸면, 정작 필요한 글자가 빠진 폰트를 문서에 적용하기 전에 알아챕니다.</li>
        </ul>
      </div>
      <div class="flex-1 min-w-0 flex justify-center animate-reveal delay-1">
        <img
          src={img('my-fonts')}
          alt="설치됨 표시와 한글 지원 여부가 붙은 폰트 목록"
          class="screenshot w-full max-w-[280px]"
          width="1090" height="2079" loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ── More ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14 animate-reveal">
        <span class="section-label">More</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight">쓰다 보면 고마워지는 것들</h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">

        <div class="mini-card animate-reveal delay-1 bg-card border border-border rounded-2xl p-6">
          <h3 class="text-sm font-semibold text-text mb-1.5">다시 깔아야 할 때</h3>
          <p class="text-xs text-text-sub leading-relaxed">
            기기를 초기화하거나 프로파일을 지우면 폰트도 함께 사라집니다. 설치했던 파일을 앱이 보관하고 있어서
            원본을 다시 구하러 다니지 않아도 돼요. 사라진 것만 골라 한 번에 되돌립니다.
          </p>
        </div>

        <div class="mini-card animate-reveal delay-2 bg-card border border-border rounded-2xl p-6">
          <h3 class="text-sm font-semibold text-text mb-1.5">찾기와 고르기</h3>
          <p class="text-xs text-text-sub leading-relaxed">
            폰트가 쌓이면 이름으로 검색하고, 설치됨·미설치로 걸러내고, 순서를 바꿔 봅니다.
            수십 개가 되어도 원하는 하나를 금방 집어낼 수 있어요.
          </p>
        </div>

        <div class="mini-card animate-reveal delay-3 bg-card border border-border rounded-2xl p-6">
          <h3 class="text-sm font-semibold text-text mb-1.5">iPhone과 iPad</h3>
          <p class="text-xs text-text-sub leading-relaxed">
            같은 앱으로 두 기기 모두에 설치합니다. 넓은 화면에서는 미리보기 글자가 더 크게 보여서
            실제 문서에서 어떻게 읽힐지 가늠하기 좋아요.
          </p>
        </div>

        <div class="mini-card animate-reveal delay-1 bg-card border border-border rounded-2xl p-6">
          <h3 class="text-sm font-semibold text-text mb-1.5">다섯 가지 언어</h3>
          <p class="text-xs text-text-sub leading-relaxed">
            한국어, 영어, 일본어, 중국어 간체·번체를 지원합니다. 설치 안내 문구도 각 언어로 쓰여 있어서
            낯선 화면 앞에서 번역하며 읽지 않아도 됩니다.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Closing ── -->
  <section class="py-20 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto text-center animate-reveal">
      <p class="text-base text-text font-medium mb-2">폰트 파일과 설치 기록은 기기 안에만 있습니다.</p>
      <p class="text-sm text-text-sub">계정도, 로그인도 없어요.</p>
    </div>
  </section>

  <!-- ── Back ── -->
  <div class="max-w-5xl mx-auto px-6 py-12 border-t border-border flex flex-wrap items-center justify-between gap-4">
    <a href="/ko/apps" class="text-sm text-text-sub hover:text-text transition">← {t('apps.title')}</a>
    <div class="flex items-center gap-6">
      <a href="/ko/apps/superfont/support/" class="text-sm text-text-sub hover:text-text transition">지원</a>
      <a href="/ko/apps/superfont/privacy/" class="text-sm text-text-sub hover:text-text transition">개인정보처리방침</a>
    </div>
  </div>

</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.08, rootMargin: '0px 0px -24px 0px' }
  );
  document.querySelectorAll('.animate-reveal').forEach(el => observer.observe(el));
</script>
