      points: {
        iphone: [
          '알림음은 미리 들어보고 고르니, 어떤 소리로 울릴지 모른 채 넘어가지 않아요.',
          '제목·색·시간·알림·메모가 한 화면에 있으니, 기억해야 할 건 일정 안에 담아두면 됩니다.',
        ],
        ipad: [
          '알림음은 미리 들어보고 고르니, 어떤 소리로 울릴지 모른 채 넘어가지 않아요.',
          '편집은 일정 블록 옆에 열리는 창에서 — 시간표를 가리지 않아, 고치면서 한 주 전체를 봅니다.',
        ],
      },
      shots: {
        iphone: [
          { file: 'alarm', alt: '알림 두 개가 설정된 일정 편집 화면' },
          { file: 'quick-edit', alt: '제목, 요일, 시간, 알림, 메모가 있는 일정 편집 화면' },
        ],
        ipad: [
          { file: 'alarm', alt: 'iPad에서 알림 두 개가 설정된 편집 창' },
          { file: 'edit-panel', alt: 'iPad에서 일정 블록 옆에 열리는 편집 창' },
        ],
      },
