const footerLinks = [
  { href: '/ko/apps/timetable/privacy/', label: '개인정보처리방침' },
];
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>
  <AppPage lang={lang} slug="timetable" app={app} copy={copy} footerLinks={footerLinks} />
</BaseLayout>
