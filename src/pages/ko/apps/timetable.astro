        ipad: [
          { file: 'image-share', alt: 'iPad 이미지 내보내기 화면 — 미리보기와 오른쪽 옵션 열' },
          { file: 'print', alt: 'iPad 인쇄 화면 — 용지 미리보기와 오른쪽 옵션 열' },
        ],
      },
