---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TimetableAppPage, { type Copy } from '../../../components/TimetableAppPage.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'ko/timetable'))!;

const copy: Copy = {
  tagline: '손으로 그리는 시간표',
  summary: '머릿속에 있는 한 주를 그대로 화면에 옮기세요. 드래그로 그리고, 홈 화면에서 보고, 종이에 붙입니다.',
  hero: { iphone: 'SuperTimetable 주간 시간표 화면 (iPhone)', ipad: 'SuperTimetable 주간 시간표 화면 (iPad)' },
  tabs: { iphone: 'iPhone', ipad: 'iPad' },
  closing: ['시간표는 기기 안에만 저장됩니다.', '계정도, 로그인도 없어요.'],
  sections: [
    {
      label: 'Just Drag',
      title: '만들기도 옮기기도 늘리기도, 드래그로 뚝딱',
      lead: {
        iphone: '빈 칸을 긁으면 그 자리에 일정이 생깁니다. 시작과 끝을 숫자로 따져가며 입력할 일이 없어요. 손가락을 따라오는 시간 라벨과 손끝의 진동이 지금 어느 시각에 닿았는지 알려줍니다.',
        ipad: '빈 칸을 긁으면 그 자리에 일정이 생깁니다. 시작과 끝을 숫자로 따져가며 입력할 일이 없어요. 손가락을 따라오는 시간 라벨이 지금 어느 시각에 닿았는지 알려줍니다.',
      },
      steps: [
        ['만들기', '빈 칸을 위아래로 긁으면 그만큼 일정이 생겨요.'],
        ['옮기기', '블록을 집어 다른 요일에 내려놓으면 요일과 시각이 함께 따라와요. 지우고 새로 만들 필요가 없습니다.'],
        ['늘이기', '끝을 잡아당기면 그쪽만 늘어나요. 정확한 값이 필요할 땐 편집 화면에서 직접 지정하면 됩니다.'],
      ],
      shots: {
        iphone: [
          { file: 'drag-create', alt: '빈 칸을 드래그해 일정 만들기' },
          { file: 'move-drag', alt: '시간 라벨을 보며 다른 요일로 옮기기' },
          { file: 'resize-drag', alt: '아래 핸들을 당겨 시간 늘이기' },
        ],
        ipad: [
          { file: 'drag-create', alt: 'iPad 그리드에서 빈 칸을 드래그해 일정 만들기' },
        ],
      },
    },
    {
      label: 'Undo & Lock',
      title: '몇 번이고 고쳐도 부담이 없어요',
      lead: '시간표는 한 번에 완성되지 않아요. 옮기고, 늘이고, 다시 옮기는 일이 대부분이라 고치는 과정 자체를 가볍게 만들었습니다.',
      points: [
        '드래그하는 동안 주변 블록에 가이드 라인이 떠서, 몇 분씩 어긋난 빈틈이 생기지 않아요.',
        '실행 취소와 다시 실행에 횟수 제한이 없으니, 마음 놓고 이리저리 바꿔볼 수 있어요.',
        '다 만든 시간표는 잠가두면, 확인만 하다 실수로 건드리는 일이 없습니다.',
      ],
      shots: {
        iphone: [
          { file: 'undo-redo', alt: '옮긴 블록을 실행 취소로 되돌리기' },
          { file: 'lock', alt: '잠긴 시간표를 건드렸을 때의 잠금 표시' },
        ],
        ipad: [
          { file: 'lock', alt: 'iPad에서 잠긴 시간표를 건드렸을 때의 잠금 표시' },
        ],
      },
    },
    {
      label: 'Batch Edit',
      title: '하나만 고치면 나머지도 따라와요',
      lead: '같은 수업이 일주일에 세 번이면, 이름을 바꿀 곳도 세 군데죠. 제목과 색이 같은 블록은 한 묶음이라, 하나만 바꾸면 나머지도 함께 바꿀지 물어봅니다.',
      points: [
        '바뀌기 전과 후를 나란히 보여주니, 모르고 건드릴 일이 없어요.',
        '각 블록의 요일·시간·메모·알림은 그대로 남습니다.',
      ],
      shots: {
        iphone: [
          { file: 'batch-edit', alt: '같은 일정을 함께 바꿀지 묻는 확인 시트' },
          { file: 'batch-edit-after', alt: '같은 일정이 모두 새 제목과 색으로 바뀐 그리드' },
        ],
        ipad: [
          { file: 'batch-edit', alt: 'iPad에서 같은 일정을 함께 바꿀지 묻는 확인 창' },
        ],
      },
    },
    {
      label: 'Your Style',
      title: '색도 이름도 내 마음대로',
      lead: '한 번 쓴 제목과 색 조합은 목록에 남아서, 같은 수업을 하나 더 넣을 땐 고르기만 하면 돼요. 마음에 드는 색이 없으면 직접 만들면 됩니다.',
      points: [
        '직접 만든 색은 내 색상 목록에 남아, 다음 일정에서도 바로 고를 수 있어요.',
        '과목마다 색이 다르니, 한 주가 색으로 정리됩니다.',
      ],
      shots: {
        iphone: [
          { file: 'style-sheet', alt: '이미 쓴 제목·색 조합을 고르는 스타일 목록' },
          { file: 'custom-color-picker', alt: '원하는 색을 직접 만드는 색상 편집기' },
          { file: 'custom-color', alt: '직접 만든 색이 추가된 스타일 목록' },
        ],
        ipad: [
          { file: 'style-sheet', alt: 'iPad에서 색 원에 붙어 열리는 스타일 선택 팝오버' },
        ],
      },
    },
    {
      label: 'Display',
      title: '내가 쓰는 요일과 시간만',
      lead: '쓰지도 않는 새벽 시간이 화면을 차지하면 정작 볼 곳이 좁아지죠. 보이는 요일과 시간대를 시간표마다 좁히면, 실제로 쓰는 시간이 화면을 꽉 채웁니다.',
      points: [
        '한 주의 시작 요일과 시간 표기는 쓰던 방식 그대로.',
        '주말까지 넓히거나 평일만 남기거나, 시간표마다 따로 정해요.',
      ],
      shots: {
        iphone: [
          { file: 'display-settings', alt: '표시 요일과 시간 범위를 고르는 표시 방식 시트' },
          { file: 'day-range', alt: '일요일까지 보이도록 넓힌 시간표' },
        ],
        ipad: [
          { file: 'display-settings', alt: 'iPad의 표시 방식 설정 창' },
          { file: 'day-range', alt: 'iPad에서 일요일까지 보이도록 넓힌 시간표' },
        ],
      },
    },
    {
      label: 'Dark Mode',
      title: '밤에도 눈이 편하도록',
      lead: '화면 밝기는 주변에 맞춰 두거나, 늘 보던 쪽으로 고정합니다. 어두운 화면에서도 색은 그대로 또렷해서, 불 끄고도 내일 첫 수업이 보여요.',
      shots: {
        iphone: [
          { file: 'dark-mode', alt: '다크 모드 시간표' },
        ],
        ipad: [
          { file: 'dark-mode', alt: 'iPad 다크 모드 시간표' },
        ],
      },
    },
    {
      label: 'Alarms & Edit',
      title: '시작 전에 알아서 울리도록',
      lead: '챙겨야 할 시간과 시작하는 시간은 다르죠. 일정마다 알림을 두 개까지 걸어, 미리 준비할 때와 시작할 때 따로 받습니다.',
      points: {
        iphone: [
          '알림음은 미리 들어보고 고르니, 어떤 소리로 울릴지 모른 채 넘어가지 않아요.',
          '제목·색·시간·알림·메모가 한 화면에 있으니, 기억해야 할 건 일정 안에 담아두면 됩니다.',
        ],
        ipad: [
          '알림음은 미리 들어보고 고르니, 어떤 소리로 울릴지 모른 채 넘어가지 않아요.',
          '편집은 블록 옆에 뜨는 패널에서 바로 — 시트가 그리드를 가리지 않아, 고치면서 한 주 전체를 봅니다.',
        ],
      },
      shots: {
        iphone: [
          { file: 'alarm', alt: '알림 두 개가 설정된 일정 편집 화면' },
          { file: 'quick-edit', alt: '제목, 요일, 시간, 알림, 메모가 있는 일정 편집 화면' },
        ],
        ipad: [
          { file: 'alarm', alt: 'iPad에서 알림 두 개가 설정된 편집 패널' },
          { file: 'edit-panel', alt: 'iPad에서 블록 옆에 뜨는 편집 패널' },
        ],
      },
    },
    {
      label: 'Widgets',
      title: '앱을 열지 않아도 다음 일정이 보여요',
      lead: '확인하려고 매번 앱을 여는 게 가장 번거로운 일이죠.',
      points: [
        '홈 화면 위젯은 한 주 전체를, 오늘 위젯은 지금 이 순간을 가운데 둔 타임라인을 보여줘요.',
        '잠금 화면 위젯은 다음 일정 하나만 알려줍니다.',
        '위젯마다 어떤 시간표를 띄울지 골라, 지금 필요한 것만 남겨요.',
      ],
      shots: {
        iphone: [
          { file: 'widget-light', alt: '라이트 모드 홈 화면의 주간·오늘 위젯' },
          { file: 'widget-dark', alt: '다크 모드 홈 화면의 주간·오늘 위젯' },
        ],
        ipad: [
          { file: 'widget-light', alt: 'iPad 홈 화면의 주간·오늘 위젯' },
          { file: 'widget-dark', alt: 'iPad 다크 모드 홈 화면의 주간·오늘 위젯' },
        ],
      },
    },
    {
      label: 'Share & Print',
      title: '이미지로도, 파일로도, 종이로도',
      lead: '시간표는 벽에 붙기도 하고, 누군가에게 건네지기도 하니까요.',
      points: {
        iphone: [
          '용지와 방향만 정하면 앱에서 바로 인쇄돼요. 화면 색 그대로 또렷하게.',
          '이미지로 내보낼 땐 고른 설정이 미리보기에 바로 반영되니, 보내기 전에 확인할 수 있어요.',
          '파일로 공유하면 백업이 되고, 받은 사람은 편집 가능한 사본으로 열어 이어서 고칩니다.',
        ],
        ipad: [
          '옵션은 오른쪽 열에 따로 있어, 미리보기를 크게 보면서 고릅니다.',
          '용지와 방향만 정하면 앱에서 바로 인쇄돼요. 화면 색 그대로 또렷하게.',
          '파일로 공유하면 백업이 되고, 받은 사람은 편집 가능한 사본으로 열어 이어서 고칩니다.',
        ],
      },
      shots: {
        iphone: [
          { file: 'image-share', alt: '미리보기가 있는 공유 화면' },
          { file: 'print', alt: '용지 위 배치를 보여주는 인쇄 미리보기' },
        ],
        ipad: [
          { file: 'image-share', alt: 'iPad 공유 화면 — 미리보기와 오른쪽 옵션 열' },
          { file: 'print', alt: 'iPad 인쇄 화면 — 용지 미리보기와 오른쪽 옵션 열' },
        ],
      },
    },
    {
      label: 'Timetable List',
      title: '여러 시간표를 하나의 앱으로',
      lead: '한 사람에게도 한 주가 여러 개죠. 학기별로, 가족 구성원별로 시간표를 따로 두세요.',
      points: [
        '새 학기는 지난 시간표를 복제해, 바뀐 부분만 고쳐요.',
        '미리보기를 넘겨 탭 한 번에 전환합니다.',
      ],
      shots: {
        iphone: [
          { file: 'timetable-list', alt: '미리보기를 넘기며 고르는 시간표 목록' },
        ],
        ipad: [
          { file: 'timetable-list', alt: 'iPad에서 그리드 위에 떠 있는 시간표 목록' },
        ],
      },
    },
  ],
};
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>
  <TimetableAppPage lang={lang} app={app} copy={copy} />
</BaseLayout>
