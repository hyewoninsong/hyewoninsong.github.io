  hero: { iphone: 'SuperTimetable 주간 시간표 화면 (iPhone)', ipad: 'SuperTimetable 주간 시간표 화면 (iPad)' },
  tabs: { iphone: 'iPhone', ipad: 'iPad' },
  closing: ['시간표는 기기에 저장됩니다.', '계정도, 로그인도 없어요.'],
  sections: [
