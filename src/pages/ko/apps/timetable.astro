---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'ko/timetable'))!;

const { platforms = {} } = app.data;
const hasIOS = platforms.iphone || platforms.ipad || platforms.mac;
const hasAndroid = !!platforms.android;

const badgeClass = (status: 'released' | 'in-development') =>
  status === 'released'
    ? 'border-green-200 bg-green-50 text-green-700'
    : 'border-border bg-muted text-muted-foreground';

const statusLabel = (status: 'released' | 'in-development') =>
  status === 'released' ? t('status.released') : t('status.dev');

const img = (name: string) => `/apps/timetable/ko/${name}.png`;
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>

  <style>
    .animate-reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .animate-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .delay-1 { transition-delay: 0.06s; }
    .delay-2 { transition-delay: 0.12s; }
    .delay-3 { transition-delay: 0.18s; }

    .screenshot {
      border-radius: 2.5rem;
      box-shadow: 0 20px 60px rgba(0,0,0,0.12), 0 4px 16px rgba(0,0,0,0.08);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      display: block;
    }
    .screenshot:hover {
      transform: scale(1.02) translateY(-2px);
      box-shadow: 0 28px 72px rgba(0,0,0,0.16), 0 6px 20px rgba(0,0,0,0.1);
    }

    .section-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-primary);
      margin-bottom: 0.75rem;
    }

    .screenshot-pair {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding: 0.5rem 0;
    }
    .screenshot-pair::-webkit-scrollbar { display: none; }
    .screenshot-pair img { flex-shrink: 0; }

    .step-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }
    .step-list li {
      display: flex;
      gap: 0.75rem;
      font-size: 0.875rem;
      color: var(--color-text-sub);
      line-height: 1.6;
    }
    .step-list li span:first-child {
      flex-shrink: 0;
      font-weight: 600;
      color: var(--color-text);
      min-width: 4.5rem;
    }

    .mini-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .mini-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.08);
    }
    .mini-card img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      object-position: top;
    }
    .mini-card img.from-bottom { object-position: bottom; }
  </style>

  <div class="max-w-5xl w-full mx-auto px-6 py-24 md:py-36">

    <!-- ── Header ── -->
    <div class="text-center mb-20 md:mb-28 animate-reveal">
      <h1 class="text-3xl md:text-4xl font-semibold text-text tracking-tight mb-3">{app.data.title}</h1>
      <p class="text-base text-text-sub mb-6 max-w-md mx-auto">{app.data.summary}</p>

      <div class="flex flex-col items-center gap-2">
        {hasIOS && (
          <div class="flex items-center gap-2 flex-wrap justify-center">
            <span class="flex items-center gap-1 text-xs text-text-sub w-16 justify-end shrink-0">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 shrink-0">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
              </svg>
              iOS
            </span>
            <div class="flex gap-1.5 flex-wrap justify-center">
              {platforms.iphone && (
                <span class:list={['inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-medium', badgeClass(platforms.iphone)]}>
                  iPhone · {statusLabel(platforms.iphone)}
                </span>
              )}
              {platforms.ipad && (
                <span class:list={['inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-medium', badgeClass(platforms.ipad)]}>
                  iPad · {statusLabel(platforms.ipad)}
                </span>
              )}
            </div>
          </div>
        )}
        {hasAndroid && (
          <div class="flex items-center gap-2 justify-center">
            <span class="flex items-center gap-1 text-xs text-text-sub w-16 justify-end shrink-0">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 shrink-0">
                <path d="M17.523 15.341a.985.985 0 01-.984-.984.985.985 0 01.984-.984.985.985 0 01.984.984.985.985 0 01-.984.984m-11.046 0a.985.985 0 01-.984-.984.985.985 0 01.984-.984.985.985 0 01.984.984.985.985 0 01-.984.984m11.405-6.022l1.969-3.411a.41.41 0 00-.149-.559.41.41 0 00-.559.149l-1.994 3.454A11.774 11.774 0 0012 8.098c-1.73 0-3.364.393-4.799 1.084L5.207 5.698a.41.41 0 00-.559-.149.41.41 0 00-.149.559l1.969 3.411C3.945 10.878 2.5 13.239 2.5 15.898h19c0-2.659-1.445-5.02-3.618-6.579z"/>
              </svg>
              Android
            </span>
            <span class:list={['inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-medium', badgeClass(platforms.android!)]}>
              {statusLabel(platforms.android!)}
            </span>
          </div>
        )}
      </div>

      {app.data.appStoreUrl && (
        <a href={app.data.appStoreUrl} target="_blank" rel="noopener noreferrer"
           class="inline-block mt-5 text-sm text-primary hover:underline">
          App Store →
        </a>
      )}
    </div>

    <!-- ── Intro screenshot ── -->
    <div class="flex justify-center mb-28 animate-reveal delay-1">
      <img
        src={img('hero')}
        alt="SuperTimetable 주간 시간표 화면"
        class="screenshot w-full max-w-[300px]"
      />
    </div>

  </div>

  <!-- ── Section: Drag & Gestures ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Drag & Gestures</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">손으로 완성하는 시간표</h2>
        <p class="text-text-sub leading-relaxed">
          입력 폼도, 날짜 선택창도 없어요. 모든 일정은 그리드 위에서 바로 만들고, 옮기고, 늘립니다.
          손가락을 따라오는 시간 라벨이 지금 몇 시인지 실시간으로 알려줘요.
        </p>
        <ul class="step-list">
          <li><span>만들기</span><span>빈 칸을 드래그하면 끝. 위로 끌든 아래로 끌든 그 방향으로 블록이 늘어나요.</span></li>
          <li><span>옮기기</span><span>블록을 집어 다른 요일이나 시간에 내려놓으세요. 1분 지날 때마다 손끝에 진동이 톡톡 전해져요.</span></li>
          <li><span>늘이기</span><span>위아래 핸들을 잡아당기면 그쪽 끝만 바뀝니다.</span></li>
        </ul>
        <p class="text-text-sub leading-relaxed mt-5">
          드래그 중에는 주변 블록의 경계에 가이드 라인이 떠서 딱 맞게 붙일 수 있고,
          화면 끝에 닿으면 그리드가 알아서 스크롤됩니다.
        </p>
      </div>
      <div class="flex-1 screenshot-pair animate-reveal delay-1">
        <img src={img('drag-create')} alt="빈 칸을 드래그해 일정 만들기" class="screenshot w-full max-w-[200px]" />
        <img src={img('move-drag')} alt="시간 라벨을 보며 다른 요일로 옮기기" class="screenshot w-full max-w-[200px]" />
        <img src={img('resize-drag')} alt="아래 핸들을 당겨 시간 늘이기" class="screenshot w-full max-w-[200px]" />
      </div>
    </div>
  </section>

  <!-- ── Section: Edit Sheet ── -->
  <section class="py-24 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Edit Sheet</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">일정 하나에 필요한 건 전부 한 화면에</h2>
        <p class="text-text-sub leading-relaxed mb-4">
          블록을 탭하면 캘린더 앱 같은 편집 시트가 열려요. 제목, 색상, 요일, 시간이 맨 위에,
          그 아래 알림 두 개와 메모까지. 기억해야 할 건 일정 안에 다 담아두세요.
        </p>
        <p class="text-text-sub leading-relaxed mb-4">
          알림은 정시부터 5분 전, 최대 2시간 전까지 고를 수 있고 사운드도 5가지 중에서 선택해요.
          한 번으로 부족하면 두 번째 알림을 추가하면 됩니다.
        </p>
        <p class="text-text-sub leading-relaxed">
          기본 색상 10가지 중에 고르거나, 색상 편집기로 원하는 색을 직접 만들 수 있어요.
          나중에 그 색을 바꾸면 모든 시간표에서 그 색을 쓰던 블록이 한꺼번에 바뀝니다.
        </p>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('quick-edit')} alt="제목, 색상, 요일, 시간, 알림, 메모가 있는 편집 시트" class="screenshot w-full max-w-[220px]" />
        <img src={img('color-variant')} alt="같은 일정에 다른 색상을 적용한 모습" class="screenshot w-full max-w-[220px]" />
      </div>
    </div>
  </section>

  <!-- ── Section: Batch Update ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Batch Update</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">하나만 고치면 나머지도 따라와요</h2>
        <p class="text-text-sub leading-relaxed mb-4">
          제목과 색상이 같은 블록은 같은 스타일로 묶여요. 그중 하나의 이름이나 색을 바꾸면
          나머지 블록도 같이 바꿀지 물어봅니다. 바뀌기 전과 후를 나란히 보여주니까
          뭐가 달라지는지 바로 알 수 있어요.
        </p>
        <p class="text-text-sub leading-relaxed">
          바뀌는 건 제목과 색상뿐. 각 블록의 요일, 시간, 메모, 알림은 그대로 유지됩니다.
        </p>
      </div>
      <div class="flex-1 flex justify-center animate-reveal delay-1">
        <img src={img('batch-edit')} alt="같은 스타일 일정을 함께 바꿀지 묻는 확인 시트" class="screenshot w-full max-w-[280px]" />
      </div>
    </div>
  </section>

  <!-- ── Section: Custom View ── -->
  <section class="py-24 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Custom View</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">필요한 것만 보여주는 화면</h2>
        <p class="text-text-sub leading-relaxed mb-4">
          시간표마다 보기 설정이 따로 있어요. 평일만, 토요일까지, 또는 일주일 전체를 보여주고
          한 주의 시작을 월요일이나 일요일로 정할 수 있습니다.
        </p>
        <p class="text-text-sub leading-relaxed mb-4">
          시간 슬라이더를 끌어 오전 몇 시간만 보든 24시간을 다 보든 자유롭게. 실제로 쓰는 시간대가
          화면을 꽉 채웁니다.
        </p>
        <p class="text-text-sub leading-relaxed">
          12시간제와 24시간제, 라이트·다크·자동 모드도 원하는 대로. 편집이 끝나면 그리드를 잠가서
          실수로 뭔가 움직이는 일을 막아두세요.
        </p>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('day-range')} alt="요일 범위를 조정한 시간표" class="screenshot w-full max-w-[220px]" />
        <img src={img('dark-mode')} alt="다크 모드 시간표" class="screenshot w-full max-w-[220px]" />
      </div>
    </div>
  </section>

  <!-- ── Section: Widgets ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Widgets</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">앱을 열지 않아도 바로 보여요</h2>
        <p class="text-text-sub leading-relaxed mb-4">
          주간 위젯은 시간표 전체를 홈 화면에 올려줍니다. 큰 크기와 특대 크기를 지원하고,
          오늘 요일과 현재 시각이 강조돼요.
        </p>
        <p class="text-text-sub leading-relaxed mb-4">
          오늘 위젯은 지금 이 순간을 가운데 둔 타임라인이에요. 작은 크기부터 특대까지 모두 지원하고,
          탭하면 바로 앱으로 들어갑니다.
        </p>
        <p class="text-text-sub leading-relaxed">
          위젯마다 어떤 시간표를 보여줄지 고를 수 있고, 시스템 외관과 12·24시간제 설정을 그대로 따라갑니다.
        </p>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('widget-light')} alt="라이트 모드 홈 화면의 주간·오늘 위젯" class="screenshot w-full max-w-[220px]" />
        <img src={img('widget-dark')} alt="다크 모드 홈 화면의 주간·오늘 위젯" class="screenshot w-full max-w-[220px]" />
      </div>
    </div>
  </section>

  <!-- ── Section: Share & Print ── -->
  <section class="py-24 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Share & Print</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">화면으로, 종이로, 다른 기기로</h2>
        <p class="text-text-sub leading-relaxed mb-4">
          시간표를 깔끔한 이미지로 내보내세요. 라이트·다크, 12·24시간제를 고르면
          미리보기가 바로 바뀌어서 공유 전에 확인할 수 있어요.
        </p>
        <p class="text-text-sub leading-relaxed mb-4">
          앱에서 바로 인쇄도 됩니다. A3부터 Letter, 직접 입력한 용지 크기까지, 세로·가로, 맞춤·채움,
          한 장에 1·2·4개 배치까지 고를 수 있어요. 미리보기를 핀치로 확대해 구석구석 확인하세요.
        </p>
        <p class="text-text-sub leading-relaxed">
          파일로 공유하면 백업도 되고 다른 사람에게 통째로 넘길 수도 있어요.
          SuperTimetable이 있는 사람이라면 누구나 바로 편집 가능한 사본으로 열립니다.
        </p>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('image-share')} alt="라이트·다크 미리보기가 있는 공유 시트" class="screenshot w-full max-w-[220px]" />
        <img src={img('print')} alt="용지 크기, 방향, 장당 개수를 고르는 인쇄 옵션" class="screenshot w-full max-w-[220px]" />
      </div>
    </div>
  </section>

  <!-- ── More Features ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14 animate-reveal">
        <span class="section-label">More</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight">세심하게 다듬은 기능들</h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <div class="mini-card animate-reveal delay-1 bg-card border border-border rounded-2xl overflow-hidden">
          <img src={img('timetable-list')} alt="실물 크기 미리보기가 있는 시간표 목록" />
          <div class="p-5">
            <h3 class="text-sm font-semibold text-text mb-1.5">여러 개의 시간표</h3>
            <p class="text-xs text-text-sub leading-relaxed">
              학기별, 직장별, 가족 구성원별로 따로 만들어두세요. 실물 크기 미리보기를 넘겨보며 탭 한 번에 전환합니다.
            </p>
          </div>
        </div>

        <div class="mini-card animate-reveal delay-2 bg-card border border-border rounded-2xl overflow-hidden">
          <img src={img('duplicate-timetable')} alt="목록에서 시간표 복제하기" />
          <div class="p-5">
            <h3 class="text-sm font-semibold text-text mb-1.5">시간표 복제</h3>
            <p class="text-xs text-text-sub leading-relaxed">
              새 학기는 지난 학기에서 시작하세요. 시간표를 통째로 복제하고 이름을 바꾼 뒤 달라진 부분만 손보면 됩니다.
            </p>
          </div>
        </div>

        <div class="mini-card animate-reveal delay-3 bg-card border border-border rounded-2xl overflow-hidden">
          <img src={img('title-suggestions')} alt="기존 제목·색상 조합을 보여주는 스타일 가져오기 목록" />
          <div class="p-5">
            <h3 class="text-sm font-semibold text-text mb-1.5">스타일 가져오기</h3>
            <p class="text-xs text-text-sub leading-relaxed">
