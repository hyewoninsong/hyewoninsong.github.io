---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'ko/timetable'))!;

const { platforms = {} } = app.data;
const hasIOS = platforms.iphone || platforms.ipad || platforms.mac;
const hasAndroid = !!platforms.android;

const badgeClass = (status: 'released' | 'in-development') =>
  status === 'released'
    ? 'border-green-200 bg-green-50 text-green-700'
    : 'border-border bg-muted text-muted-foreground';

const statusLabel = (status: 'released' | 'in-development') =>
  status === 'released' ? t('status.released') : t('status.dev');

const img = (name: string) => `/apps/timetable/ko/${name}.png`;
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>

  <style>
    .animate-reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .animate-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .delay-1 { transition-delay: 0.06s; }
    .delay-2 { transition-delay: 0.12s; }

    .screenshot {
      border-radius: 2.5rem;
      box-shadow: 0 20px 60px rgba(0,0,0,0.12), 0 4px 16px rgba(0,0,0,0.08);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      display: block;
    }
    .screenshot:hover {
      transform: scale(1.02) translateY(-2px);
      box-shadow: 0 28px 72px rgba(0,0,0,0.16), 0 6px 20px rgba(0,0,0,0.1);
    }

    .section-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-primary);
      margin-bottom: 0.75rem;
    }

    .screenshot-pair {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding: 0.5rem 0;
    }
    .screenshot-pair::-webkit-scrollbar { display: none; }
    .screenshot-pair img { flex-shrink: 0; }

    .step-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }
    .step-list li {
      display: flex;
      gap: 0.75rem;
      font-size: 0.875rem;
      color: var(--color-text-sub);
      line-height: 1.6;
    }
    .step-list li span:first-child {
      flex-shrink: 0;
      font-weight: 600;
      color: var(--color-text);
      min-width: 4.5rem;
    }

    .screenshot-trio {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
      margin-top: 3.5rem;
    }
    .point-list {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin-top: 1.25rem;
    }
    .point-list li {
      position: relative;
      padding-left: 1.1rem;
      font-size: 0.875rem;
      color: var(--color-text-sub);
      line-height: 1.6;
    }
    .point-list li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.7rem;
      width: 0.35rem;
      height: 0.35rem;
      border-radius: 9999px;
      background: var(--color-primary);
    }
  </style>

  <div class="max-w-5xl w-full mx-auto px-6 py-24 md:py-36">

    <!-- ── Header ── -->
    <div class="text-center mb-20 md:mb-28 animate-reveal">
      <h1 class="text-3xl md:text-4xl font-semibold text-text tracking-tight mb-3">{app.data.title}</h1>
      <p class="text-lg text-text font-medium mb-3">손으로 그리는 시간표</p>
      <p class="text-base text-text-sub mb-6 max-w-md mx-auto leading-relaxed">
        머릿속에 있는 한 주를 그대로 화면에 옮기세요.
        드래그로 그리고, 홈 화면에서 보고, 종이에 붙입니다.
      </p>

      <div class="flex flex-col items-center gap-2">
        {hasIOS && (
          <div class="flex items-center gap-2 flex-wrap justify-center">
            <span class="flex items-center gap-1 text-xs text-text-sub w-16 justify-end shrink-0">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 shrink-0">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
              </svg>
              iOS
            </span>
            <div class="flex gap-1.5 flex-wrap justify-center">
              {platforms.iphone && (
                <span class:list={['inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-medium', badgeClass(platforms.iphone)]}>
                  iPhone · {statusLabel(platforms.iphone)}
                </span>
              )}
              {platforms.ipad && (
                <span class:list={['inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-medium', badgeClass(platforms.ipad)]}>
                  iPad · {statusLabel(platforms.ipad)}
                </span>
              )}
            </div>
          </div>
        )}
        {hasAndroid && (
          <div class="flex items-center gap-2 justify-center">
            <span class="flex items-center gap-1 text-xs text-text-sub w-16 justify-end shrink-0">Android</span>
            <span class:list={['inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-medium', badgeClass(platforms.android!)]}>
              {statusLabel(platforms.android!)}
            </span>
          </div>
        )}
      </div>

      {app.data.appStoreUrl && (
        <a href={app.data.appStoreUrl} target="_blank" rel="noopener noreferrer"
           class="inline-block mt-5 text-sm text-primary hover:underline">
          App Store →
        </a>
      )}
    </div>

    <!-- ── Intro screenshot ── -->
    <div class="flex justify-center mb-28 animate-reveal delay-1">
      <img
        src={img('hero')}
        alt="SuperTimetable 주간 시간표 화면"
        class="screenshot w-full max-w-[300px]"
        width="720"
        height="1564"
      />
    </div>

  </div>

  <!-- ── Just Drag ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-2xl animate-reveal">
        <span class="section-label">Just Drag</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">만들기도 옮기기도 늘리기도, 드래그로 뚝딱</h2>
        <p class="text-text-sub leading-relaxed">
          빈 칸을 긁으면 그 자리에 일정이 생깁니다. 시작과 끝을 숫자로 따져가며 입력할 일이 없어요.
          손가락을 따라오는 시간 라벨과 손끝의 진동이 지금 어느 시각에 닿았는지 알려주니,
          화면에서 눈을 뗄 필요도 없습니다.
        </p>
        <ul class="step-list">
          <li><span>만들기</span><span>빈 칸을 위아래로 긁으면 그만큼 일정이 생겨요.</span></li>
          <li><span>옮기기</span><span>블록을 집어 다른 요일에 내려놓으면 요일과 시각이 함께 따라와요. 지우고 새로 만들 필요가 없습니다.</span></li>
          <li><span>늘이기</span><span>끝을 잡아당기면 그쪽만 늘어나요. 정확한 값이 필요할 땐 편집 화면에서 직접 지정하면 됩니다.</span></li>
        </ul>
      </div>
      <div class="screenshot-trio animate-reveal delay-1">
        <img src={img('drag-create')} alt="빈 칸을 드래그해 일정 만들기" class="screenshot w-full max-w-[240px]" width="720" height="1564" loading="lazy" />
        <img src={img('move-drag')} alt="시간 라벨을 보며 다른 요일로 옮기기" class="screenshot w-full max-w-[240px]" width="720" height="1564" loading="lazy" />
        <img src={img('resize-drag')} alt="아래 핸들을 당겨 시간 늘이기" class="screenshot w-full max-w-[240px]" width="720" height="1564" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ── Undo & Lock ── -->
  <section class="py-24 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Undo & Lock</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">몇 번이고 고쳐도 부담이 없어요</h2>
        <p class="text-text-sub leading-relaxed">
          시간표는 한 번에 완성되지 않아요. 옮기고, 늘이고, 다시 옮기는 일이 대부분이라
          고치는 과정 자체를 가볍게 만들었습니다.
        </p>
        <ul class="point-list">
          <li>드래그하는 동안 주변 블록에 가이드 라인이 떠서, 몇 분씩 어긋난 빈틈이 생기지 않아요.</li>
          <li>실행 취소와 다시 실행에 횟수 제한이 없으니, 마음 놓고 이리저리 바꿔볼 수 있어요.</li>
          <li>다 만든 시간표는 잠가두면, 확인만 하다 실수로 건드리는 일이 없습니다.</li>
        </ul>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('undo-redo')} alt="옮긴 블록을 실행 취소로 되돌리기" class="screenshot w-full max-w-[220px]" width="720" height="1564" loading="lazy" />
        <img src={img('lock')} alt="잠긴 시간표를 건드렸을 때의 잠금 표시" class="screenshot w-full max-w-[220px]" width="720" height="1564" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ── Batch Edit ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Batch Edit</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">하나만 고치면 나머지도 따라와요</h2>
        <p class="text-text-sub leading-relaxed">
          같은 수업이 일주일에 세 번이면, 이름을 바꿀 곳도 세 군데죠.
          제목과 색이 같은 블록은 한 묶음이라, 하나만 바꾸면 나머지도 함께 바꿀지 물어봅니다.
        </p>
        <ul class="point-list">
          <li>바뀌기 전과 후를 나란히 보여주니, 모르고 건드릴 일이 없어요.</li>
          <li>각 블록의 요일·시간·메모·알림은 그대로 남습니다.</li>
        </ul>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('batch-edit')} alt="같은 일정을 함께 바꿀지 묻는 확인 시트" class="screenshot w-full max-w-[220px]" width="720" height="1564" loading="lazy" />
        <img src={img('batch-edit-after')} alt="같은 일정이 모두 새 제목과 색으로 바뀐 그리드" class="screenshot w-full max-w-[220px]" width="720" height="1564" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ── Your Style ── -->
  <section class="py-24 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Your Style</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">색도 이름도 내 마음대로</h2>
        <p class="text-text-sub leading-relaxed">
          한 번 쓴 제목과 색 조합은 목록에 남아서, 같은 수업을 하나 더 넣을 땐 고르기만 하면 돼요.
          마음에 드는 색이 없으면 직접 만들면 됩니다.
        </p>
        <ul class="point-list">
          <li>색을 바꾸면 그 색을 쓰던 블록이 모든 시간표에서 한꺼번에 따라와요.</li>
          <li>과목마다 색이 다르니, 한 주가 색으로 정리됩니다.</li>
        </ul>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('style-sheet')} alt="이미 쓴 제목·색 조합을 고르는 스타일 목록" class="screenshot w-full max-w-[220px]" width="720" height="1564" loading="lazy" />
        <img src={img('custom-color')} alt="직접 만든 색이 추가된 스타일 목록" class="screenshot w-full max-w-[220px]" width="720" height="1564" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ── Display ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-2xl animate-reveal">
        <span class="section-label">Display</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">내가 쓰는 요일과 시간만</h2>
        <p class="text-text-sub leading-relaxed">
          쓰지도 않는 새벽 시간이 화면을 차지하면 정작 볼 곳이 좁아지죠.
          보이는 요일과 시간대를 시간표마다 좁히면, 실제로 쓰는 시간이 화면을 꽉 채웁니다.
        </p>
        <ul class="point-list">
          <li>한 주의 시작 요일과 시간 표기는 쓰던 방식 그대로.</li>
          <li>화면 밝기는 주변에 맞춰 두거나 늘 보던 쪽으로 고정해, 밤에도 눈이 편하도록.</li>
        </ul>
      </div>
      <div class="screenshot-trio animate-reveal delay-1">
        <img src={img('display-settings')} alt="표시 요일과 시간 범위를 고르는 표시 방식 시트" class="screenshot w-full max-w-[240px]" width="720" height="1564" loading="lazy" />
        <img src={img('day-range')} alt="일요일까지 보이도록 넓힌 시간표" class="screenshot w-full max-w-[240px]" width="720" height="1564" loading="lazy" />
        <img src={img('dark-mode')} alt="다크 모드 시간표" class="screenshot w-full max-w-[240px]" width="720" height="1564" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ── Alarms ── -->
  <section class="py-24 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Alarms</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">시작 전에 알아서 울리도록</h2>
        <p class="text-text-sub leading-relaxed">
          챙겨야 할 시간과 시작하는 시간은 다르죠. 일정마다 알림을 두 개까지 걸어,
          미리 준비할 때와 시작할 때 따로 받습니다.
        </p>
        <ul class="point-list">
          <li>알림음은 미리 들어보고 고르니, 어떤 소리로 울릴지 모른 채 넘어가지 않아요.</li>
          <li>제목·색·시간·알림·메모가 한 화면에 있으니, 기억해야 할 건 일정 안에 담아두면 됩니다.</li>
        </ul>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('alarm')} alt="알림 두 개가 설정된 일정 편집 화면" class="screenshot w-full max-w-[220px]" width="720" height="1564" loading="lazy" />
        <img src={img('quick-edit')} alt="제목, 요일, 시간, 알림, 메모가 있는 일정 편집 화면" class="screenshot w-full max-w-[220px]" width="720" height="1564" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ── Widgets ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Widgets</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">앱을 열지 않아도 다음 일정이 보여요</h2>
        <p class="text-text-sub leading-relaxed">
          확인하려고 매번 앱을 여는 게 가장 번거로운 일이죠.
        </p>
        <ul class="point-list">
          <li>홈 화면 위젯은 한 주 전체를, 오늘 위젯은 지금 이 순간을 가운데 둔 타임라인을 보여줘요.</li>
          <li>잠금 화면 위젯은 다음 일정 하나만 알려줍니다.</li>
          <li>위젯마다 어떤 시간표를 띄울지 골라, 지금 필요한 것만 남겨요.</li>
        </ul>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('widget-light')} alt="라이트 모드 홈 화면의 주간·오늘 위젯" class="screenshot w-full max-w-[220px]" width="720" height="1564" loading="lazy" />
        <img src={img('widget-dark')} alt="다크 모드 홈 화면의 주간·오늘 위젯" class="screenshot w-full max-w-[220px]" width="720" height="1564" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ── Share & Print ── -->
  <section class="py-24 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Share & Print</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">이미지로도, 파일로도, 종이로도</h2>
        <p class="text-text-sub leading-relaxed">
          시간표는 벽에 붙기도 하고, 누군가에게 건네지기도 하니까요.
        </p>
        <ul class="point-list">
          <li>용지와 방향만 정하면 앱에서 바로 인쇄돼요. 화면 색 그대로 또렷하게.</li>
          <li>이미지로 내보낼 땐 고른 설정이 미리보기에 바로 반영되니, 보내기 전에 확인할 수 있어요.</li>
          <li>파일로 공유하면 백업이 되고, 받은 사람은 편집 가능한 사본으로 열어 이어서 고칩니다.</li>
        </ul>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('image-share')} alt="미리보기가 있는 공유 화면" class="screenshot w-full max-w-[220px]" width="720" height="1564" loading="lazy" />
