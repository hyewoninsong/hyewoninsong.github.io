---
/**
 * SuperPlanner 소개 — 아직 개발 중이라 **스샷이 한 장도 없다**.
 * `hero`·`tabs`·`shots` 를 비워 두면 AppPage 가 글만 있는 한 단으로 그린다.
 * 캡처 레인이 돌면 hero / 섹션마다 shots 를 채우고 tabs 를 되살린다.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppPage, { type Copy } from '../../../components/AppPage.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'ko/planner'))!;

const copy: Copy = {
  tagline: '하루를 시간축 위에 그리는 플래너',
  summary: '할 일을 목록에 쌓아 두는 대신 하루의 어디에 놓을지 정하고, 어긋나면 손가락으로 고칩니다.',
  closing: ['계획과 기록은 본인 iCloud 계정 안에서만 오갑니다.', '따로 만들 계정도, 로그인 화면도 없어요.'],
  sections: [
    {
      label: 'Plan',
      title: '빈 곳을 끌면 거기가 그 일의 시간입니다',
      lead: '적어 두는 것과 언제 할지 정하는 것은 다른 일인데, 목록은 앞의 것만 해 줍니다. 여기서는 하루의 세로 시간축에서 빈 곳을 끌면 그 자리가 곧 시간이 됩니다.',
      steps: [
        ['끌어서 범위', '누르고 끄는 동안 그 시간대가 그려집니다. 시작은 늘 정각이나 30분에 붙어서, 몇 시 몇 분인지 고르는 화면을 거치지 않아요.'],
        ['놓으면 선택', '손을 떼면 등록해 둔 할일이 올라옵니다. 고르는 순간 그 범위에 놓이고 바로 선택돼요.'],
        ['그 자리에서 새 할일', '목록에 없는 일은 맨 위에서 바로 만들어 배치합니다. 할일 탭을 다녀왔다 오지 않아도 됩니다.'],
      ],
    },
    {
      label: 'Adjust',
      title: '계획이 어긋나도 손가락 하나로 고칩니다',
      lead: '하루가 계획대로 가는 날은 드물고, 진짜 부담은 어긋날 때마다 시각을 다시 입력하는 쪽입니다. 블록은 끌면 옮겨지고 끝을 잡으면 늘어납니다 — 고치는 문법이 그 둘뿐이에요.',
      points: [
        '5분 단위로 붙고 앞뒤 일정의 경계에는 자석처럼 걸립니다. 몇 분인지 계산할 일이 없어요.',
        '겹쳐 놓아도 앱이 되묻지 않습니다. 겹친 구간만 빗금으로 표시되고, 정리할지는 내가 정해요.',
        '화면 끝까지 끌면 알아서 스크롤되고, 자정에 닿으면 블록이 눌리며 손끝에 걸립니다.',
        '무엇을 하든 좌하단 되돌리기로 돌아옵니다 — 50번까지 거슬러요.',
        '오른쪽 스크롤바가 하루 전체를 줄여 그립니다. 잡고 밀면 화면 밖 일정이 어떻게 놓여 있는지도 같이 보여요.',
      ],
    },
    {
      label: 'Shift',
      title: '하나가 밀리면 뒤도 같이 밀어야 하죠',
      lead: '회의가 30분 길어지면 그 뒤가 전부 밀립니다. 하나씩 끌어 옮기다 보면 순서가 엉키고요. 블록을 고르고 아래쪽 칩을 누르면 뒤 일정이 한 줄로 이어지고, 그다음은 하나만 끌면 됩니다.',
      points: [
        '위 칩은 그 앞 전부, 아래 칩은 그 뒤 전부를 한 번에 잇습니다. 칩 모양이 몇 개가 이어졌는지를 그대로 보여 줘요.',
        '빼고 싶은 일정은 그 블록의 연결 버튼을 눌러 실에서 뺍니다. 거기만 놔두고 나머지를 밀 수 있어요.',
        '따라오던 일정은 앞에 놓인 다른 일정을 만나면 그 앞에 섭니다 — 묶음이 지나가면서 새 겹침을 깔지 않아요.',
        '열 개를 옮겼어도 되돌리기는 한 번입니다.',
      ],
    },
    {
      label: 'Drawer',
      title: '오늘 못 한 일을 지우지 않아도 됩니다',
      lead: '못 한 일을 지우면 기록이 같이 사라지고, 그냥 두면 내일 계획을 가립니다. 블록을 우하단 서랍 위에 끌어다 놓으면 타임라인에서만 빠지고 내용은 그대로 남아요.',
      points: [
        '메모도 알람도 그대로입니다. 잔디와 통계에서만 빠져서, 안 한 일이 한 것처럼 세어지지 않아요.',
        '한꺼번에 넣은 일정은 서랍에서도 한 줄이고, 꺼내면 넣을 때의 간격 그대로 전부 나옵니다.',
        '꺼낸 자리는 지금 보고 있는 날의 화면 한가운데예요. 빈 자리를 못 찾아 실패하는 경우가 없습니다.',
        '하루치를 통째로 다시 깔거나 미완료만 내일로 보내는 것은 툴바 정리 메뉴 한 자리에 있습니다.',
      ],
    },
    {
      label: 'Track',
      title: '따로 적지 않아도 기록이 쌓입니다',
      lead: '무엇을 얼마나 했는지 알려면 보통 계획과 별개로 한 번 더 적어야 합니다. 여기서는 배치해 둔 것이 곧 기록이고, 할일 탭이 그걸 모아 보여 줍니다.',
      points: [
        '오늘 완료한 개수, 이번 주에 쓴 시간, 배치가 이어진 연속 일수가 맨 위 타일 셋입니다.',
        '잔디는 일별·주별·월별로 바꿔 봅니다. 칸을 누르면 그 날의 플래너로 바로 건너뛰어요.',
        '할일 하나를 열면 이번 주·이번 달·올해·전체 시간과 기록 달력, 날짜별 메모가 나옵니다.',
        '안 하게 된 할일은 보관합니다 — 목록에서만 빠지고 지난 기록은 그대로 조회돼요.',
      ],
    },
    {
      label: 'Profiles',
      title: '일과 공부를 한 화면에 섞지 않습니다',
      lead: '업무 일정과 개인 일정이 한 타임라인에 섞이면 둘 다 안 읽힙니다. 프로필을 나누면 화면에는 지금 고른 프로필의 할일과 배치만 나옵니다.',
      points: [
        '프로필마다 할일도 기록도 따로입니다. 열 개까지 만들 수 있어요.',
        '어느 프로필을 펴 둘지는 기기마다 따로 기억합니다 — 한쪽은 일, 한쪽은 공부로 둘 수 있어요.',
        '알람은 배치마다 미리알림·시작·종료 세 자리이고 소리를 따로 고릅니다. 기기가 여럿이어도 울릴 기기를 정해 두면 같은 알람이 여러 번 울리지 않아요.',
        '기록은 기기에 이미 로그인된 iCloud 계정으로 따라옵니다. 이 앱을 위해 만들 계정이나 로그인 화면은 없습니다.',
      ],
    },
  ],
};
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>
  <AppPage lang={lang} slug="planner" app={app} copy={copy} />
</BaseLayout>
