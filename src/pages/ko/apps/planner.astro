---
/**
 * SuperPlanner 소개. 스샷은 앱 저장소의 캡처 레인(`scripts/appstore-capture.sh`)이 떨군 원본을
 * `web-app-page/scripts/collect-shots.sh` 로 옮겨 온다 — `public/apps/planner/{ko,en}/` · `…/ipad/`.
 * iPad 는 세로 캡처라 `ipadShot="plain"` · 720×960.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppPage, { type Copy } from '../../../components/AppPage.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'ko/planner'))!;

const copy: Copy = {
  tagline: '하루를 시간축 위에 그리는 플래너',
  summary: '할 일을 목록에 쌓아 두는 대신 하루의 어디에 놓을지 정하고, 어긋나면 손가락으로 고칩니다.',
  hero: { iphone: 'SuperPlanner 하루 타임라인 화면 (iPhone)', ipad: 'SuperPlanner 하루 타임라인 화면 (iPad)' },
  tabs: { iphone: 'iPhone', ipad: 'iPad' },
  closing: ['계획과 기록은 본인 iCloud 계정 안에서만 오갑니다.', '따로 만들 계정도, 로그인 화면도 없어요.'],
  sections: [
    {
      label: 'Plan',
      title: '빈 곳을 끌면 거기가 그 일의 시간입니다',
      lead: '적어 두는 것과 언제 할지 정하는 것은 다른 일인데, 목록은 앞의 것만 해 줍니다. 여기서는 하루의 세로 시간축에서 빈 곳을 끌면 그 자리가 곧 시간이 됩니다.',
      steps: [
        ['끌어서 범위', '누르고 끄는 동안 그 시간대가 그려집니다. 시작은 늘 정각이나 30분에 붙어서, 몇 시 몇 분인지 고르는 화면을 거치지 않아요.'],
        ['놓으면 선택', '손을 떼면 등록해 둔 할일이 올라옵니다. 고르는 순간 그 범위에 놓이고 바로 선택돼요.'],
        ['그 자리에서 새 할일', '목록에 없는 일은 맨 위에서 바로 만들어 배치합니다. 할일 탭을 다녀왔다 오지 않아도 됩니다.'],
      ],
      shots: {
        iphone: [
          { file: 'drag-create', alt: '빈 시간대를 끌어 새 배치의 범위를 그리는 중' },
          { file: 'todo-picker', alt: '손을 떼면 올라오는 할일 선택 시트' },
        ],
        ipad: [{ file: 'hero', alt: 'iPad 의 하루 타임라인' }],
      },
    },
    {
      label: 'Adjust',
      title: '계획이 어긋나도 손가락 하나로 고칩니다',
      lead: '하루가 계획대로 가는 날은 드물고, 진짜 부담은 어긋날 때마다 시각을 다시 입력하는 쪽입니다. 블록은 끌면 옮겨지고 끝을 잡으면 늘어납니다 — 고치는 문법이 그 둘뿐이에요.',
      points: [
        '5분 단위로 붙고 앞뒤 일정의 경계에는 자석처럼 걸립니다. 몇 분인지 계산할 일이 없어요.',
        '겹쳐 놓아도 앱이 되묻지 않습니다. 겹친 구간만 빗금으로 표시되고, 정리할지는 내가 정해요.',
        '화면 끝까지 끌면 알아서 스크롤되고, 자정에 닿으면 블록이 눌리며 손끝에 걸립니다.',
        '무엇을 하든 좌하단 되돌리기로 돌아옵니다 — 50번까지 거슬러요.',
        '오른쪽 스크롤바가 하루 전체를 줄여 그립니다. 잡고 밀면 화면 밖 일정이 어떻게 놓여 있는지도 같이 보여요.',
      ],
      shots: {
        iphone: [{ file: 'move-drag', alt: '블록을 잡고 다른 시간으로 끌고 가는 중' }],
        ipad: [{ file: 'group-link', alt: 'iPad 에서 고른 블록 — 위아래 묶음 칩과 늘이기 손잡이' }],
      },
    },
    {
      label: 'Shift',
      title: '하나가 밀리면 뒤도 같이 밀어야 하죠',
      lead: '회의가 30분 길어지면 그 뒤가 전부 밀립니다. 하나씩 끌어 옮기다 보면 순서가 엉키고요. 블록을 고르고 아래쪽 칩을 누르면 뒤 일정이 한 줄로 이어지고, 그다음은 하나만 끌면 됩니다.',
      points: [
        '위 칩은 그 앞 전부, 아래 칩은 그 뒤 전부를 한 번에 잇습니다. 칩 모양이 몇 개가 이어졌는지를 그대로 보여 줘요.',
        '빼고 싶은 일정은 그 블록의 연결 버튼을 눌러 실에서 뺍니다. 거기만 놔두고 나머지를 밀 수 있어요.',
        '따라오던 일정은 앞에 놓인 다른 일정을 만나면 그 앞에 섭니다 — 묶음이 지나가면서 새 겹침을 깔지 않아요.',
        '열 개를 옮겼어도 되돌리기는 한 번입니다.',
      ],
      shots: {
        iphone: [
          { file: 'group-link', alt: '아래 칩을 눌러 뒤 일정을 한 줄로 이은 상태' },
          { file: 'group-drag', alt: '이어진 묶음을 하나만 잡고 끌어 전부 옮기는 중' },
