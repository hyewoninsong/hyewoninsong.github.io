---
/**
 * SuperPlanner 소개. 스샷은 앱 저장소의 캡처 테스트(`todoUITests/AppStoreScreenshots` · `AppStoreIPadScreenshots`)가
 * 떨군 원본을 `web-app-page/scripts/collect-shots.sh` 로 옮겨 온다 — `public/apps/planner/{ko,en}/` · `…/ipad/`.
 * `list-view` 는 스토어 세트에 없는 목록 보기 장면이다(ADR-0114 이후 추가 캡처).
 * iPad 는 세로 캡처라 `ipadShot="plain"` · 720×960.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppPage, { type Copy } from '../../../components/AppPage.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'ko/planner'))!;

const copy: Copy = {
  tagline: '언제 할지까지 정하는 플래너',
  summary: '할 일 목록만 적어 두면 결국 미루게 됩니다. 적어 둔 일을 하루 시간표에 끌어다 놓고, 틀어지면 손가락으로 고치세요.',
  hero: { iphone: 'SuperPlanner 하루 타임라인 화면 (iPhone)', ipad: 'SuperPlanner 하루 타임라인 화면 (iPad)' },
  tabs: { iphone: 'iPhone', ipad: 'iPad' },
  closing: ['계획과 기록은 내 기기와 내 iCloud 에만 있고, 할 일 이름이나 메모는 어디에도 보내지 않습니다.', '따로 만들 계정도, 로그인 화면도 없어요.'],
  sections: [
    {
      label: 'Plan',
      title: '빈 곳을 끌면 거기가 그 일의 시간입니다',
      lead: '해야 할 일을 적는 것과 언제 할지 정하는 건 다른 문제인데, 목록은 앞의 것만 해 줍니다. 여기서는 하루 시간표의 빈 곳을 쭉 끌면 그 자리가 곧 시간이 됩니다.',
      steps: [
        ['끌어서 범위', '누르고 끄는 동안 그 시간대가 그려집니다. 몇 시 몇 분인지 고르는 화면을 거치지 않아요.'],
        ['놓으면 선택', '손을 떼면 만들어 둔 할일이 올라옵니다. 고르는 순간 그 범위에 놓이고 바로 선택돼요.'],
        ['그 자리에서 새 할일', '목록에 없는 일은 검색 칸에 이름을 치고 바로 만들어 배치합니다. 할일 목록을 따로 열 필요가 없어요.'],
      ],
      shots: {
        iphone: [
          { file: 'drag-create', alt: '빈 시간대를 끌어 새 배치의 범위를 그리는 중' },
          { file: 'todo-picker', alt: '손을 떼면 올라오는 할일 선택 시트' },
        ],
        ipad: [{ file: 'hero', alt: 'iPad 의 하루 타임라인' }],
      },
    },
    {
      label: 'All-day',
      title: '시간을 정할 것까지 없는 일은 하루에 넣어 둡니다',
      lead: '일기나 영단어처럼 "오늘 했다" 만 중요한 일까지 시각을 잡으면 오히려 귀찮아집니다. 상단의 타임라인·목록 버튼에서 목록 보기로 넘기면 그 날에 종일로 넣고, 했으면 체크만 하면 돼요.',
      points: [
        '오른쪽 아래 + 로 할일을 골라 그 날에 넣습니다. 같은 할일을 어떤 날은 시간표에, 어떤 날은 종일로 둘 수 있어요.',
        '줄마다 최근 7일 잔디가 붙어서, 체크하는 자리에서 며칠째 이어 가는지가 같이 보입니다.',
        '아래 일정 칸에는 그 날 시간표가 시각 순서로 나옵니다. 줄을 누르면 타임라인의 그 블록으로 넘어가요.',
        '타임라인을 보는 동안 체크 안 한 종일이 남아 있으면 목록 버튼에 개수가 뜹니다. 넣어 둔 걸 잊을 일이 없어요.',
      ],
      shots: {
        iphone: [{ file: 'list-view', alt: '목록 보기 — 위에는 종일로 넣은 할일과 7일 잔디, 아래에는 그 날 일정' }],
        ipad: [{ file: 'list-view', alt: 'iPad 의 목록 보기' }],
      },
    },
    {
      label: 'Adjust',
      title: '계획이 어긋나도 손가락 하나로 고칩니다',
      lead: '하루는 계획대로 흘러가지 않습니다. 늦어지고, 당겨지고, 또 늦어지죠. 블록은 끌면 옮겨지고 끝을 잡으면 늘어나서, 지우고 다시 만들 일이 없습니다.',
      points: [
        '앞뒤 일정의 경계에 자석처럼 붙고, 옮기는 동안 이웃 일정까지 남은 시간이 자로 보입니다. 몇 분인지 계산할 일이 없어요.',
        '겹쳐 놓아도 앱이 되묻지 않습니다. 겹친 구간만 빗금으로 표시되고, 정리할지는 내가 정해요.',
        '무엇을 하든 왼쪽 아래 되돌리기로 돌아옵니다 — 50번까지 거슬러요.',
        '들여다보기만 할 때는 왼쪽 아래 자물쇠로 잠급니다. 블록을 눌러 메모까지 읽을 수는 있고, 실수로 옮겨지지는 않아요.',
      ],
      shots: {
        iphone: [{ file: 'move-drag', alt: '블록을 잡고 다른 시간으로 끌고 가는 중' }],
        ipad: [{ file: 'group-link', alt: 'iPad 에서 고른 블록 — 위아래 묶음 칩과 늘이기 손잡이' }],
      },
    },
    {
      label: 'Shift',
      title: '하나가 밀리면 뒤도 같이 밀어야 하죠',
      lead: '회의가 30분 길어지면 그 뒤가 전부 밀립니다. 하나씩 끌어 옮기다 보면 순서가 엉키고요. 블록을 고르고 아래쪽 칩을 누르면 뒤 일정이 한 줄로 이어지고, 그다음은 하나만 끌면 됩니다.',
      points: [
        '위 칩은 그 앞 전부, 아래 칩은 그 뒤 전부를 한 번에 잇습니다. 꽉 찬 칩은 전부, 옅은 칩은 일부가 이어졌다는 뜻이에요.',
        '빼고 싶은 일정은 그 블록의 연결 버튼을 눌러 실에서 뺍니다. 거기만 놔두고 나머지를 밀 수 있어요.',
        '따라오던 일정은 앞에 놓인 다른 일정을 만나면 그 앞에 섭니다 — 묶음이 지나가면서 새 겹침을 깔지 않아요.',
        '열 개를 옮겼어도 되돌리기는 한 번입니다.',
      ],
      shots: {
        iphone: [
          { file: 'group-link', alt: '아래 칩을 눌러 뒤 일정을 한 줄로 이은 상태' },
          { file: 'group-drag', alt: '이어진 묶음을 하나만 잡고 끌어 전부 옮기는 중' },
        ],
        ipad: [{ file: 'group-drag', alt: 'iPad 에서 이어진 묶음을 끌어 옮기는 중' }],
      },
    },
    {
      label: 'Note',
      title: '같은 일이라도 그날의 메모는 그 자리에 남깁니다',
      lead: '같은 문제집이라도 날마다 풀 쪽수가 다릅니다. 고른 블록을 한 번 더 누르면 키보드 위에 입력창이 붙고, 거기 쓴 메모는 그 배치에만 남아요. "오늘은 30쪽까지" 같은 걸 적어 두는 자리입니다.',
      points: [
        '입력창이 열리면 바로 키보드가 올라옵니다. 메모 칸을 한 번 더 누를 일이 없어요.',
        '바깥을 눌러 닫아도 쓴 글은 저장됩니다. 친 글자를 버리는 길은 없습니다.',
        '입력창 맨 윗줄이 그 할일로 가는 링크입니다. 이름이나 색을 고치러 갈 때 거기서 바로 넘어가요.',
        '메모는 블록 안에 제목 아래 보입니다 — 블록이 높을수록 여러 줄이 보여요.',
      ],
      shots: {
        iphone: [{ file: 'memo', alt: '키보드 위에 붙은 배치 메모 입력창' }],
        ipad: [{ file: 'memo', alt: 'iPad 에서 키보드 위에 붙은 배치 메모 입력창' }],
      },
    },
    {
      label: 'Drawer',
      title: '오늘 못 한 일을 지우지 않아도 됩니다',
      lead: '못 한 일을 지우자니 아깝고, 그냥 두자니 오늘 계획이 지저분해집니다. 블록을 오른쪽 아래 서랍 위에 끌어다 놓으면 시간표에서만 빠지고 내용은 그대로 남아요.',
      points: [
        '메모도 알람 설정도 그대로입니다. 한꺼번에 넣은 일정은 서랍에서도 한 줄이고, 꺼내면 넣을 때의 간격 그대로 돌아와요.',
        '줄을 누르면 보고 있는 날의 화면 한가운데로 나옵니다. 옆으로 밀면 날짜와 시각을 골라 꺼낼 수 있어요.',
        '줄마다 언제 넣었는지가 붙고, 일주일이 넘은 것은 주황색이 됩니다. 묵혀 둔 일이 눈에 띄어요.',
        '서랍에서 지워도 바로 아래에 되돌리기가 뜹니다. 확인 창을 거치지 않아도 실수가 남지 않아요.',
      ],
      shots: {
        iphone: [{ file: 'drawer', alt: '서랍 시트 — 한꺼번에 넣은 묶음 한 줄과 따로 넣은 배치 한 줄' }],
        ipad: [{ file: 'drawer', alt: 'iPad 의 서랍 시트' }],
      },
    },
    {
      label: 'Track',
      title: '따로 적지 않아도 기록이 쌓입니다',
      lead: '오늘 하루만 봐서는 잘하고 있는지 알기 어렵습니다. 여기서는 해낸 배치가 곧 기록이고, 상단의 할일 버튼이 그걸 할일마다 모아 보여 줍니다.',
      points: [
        '할일마다 한 날이 잔디처럼 칸으로 채워집니다. 체크한 것만 세서, 계획만 하고 안 한 날이 한 것처럼 칠해지지 않아요.',
        '할일 하나를 열면 이번 주·이번 달·올해 그 일에 쓴 시간과 연속 일수, 기록 달력, 날짜별 메모가 나옵니다.',
        '잔디 칸을 누르면 그 날의 플래너로 바로 건너뜁니다. 빠뜨린 기록은 지난 날짜를 열어 나중에 채워 넣어요.',
        '안 하게 된 할일은 보관합니다 — 목록에서만 빠지고 지난 기록은 그대로 조회돼요.',
      ],
      shots: {
        iphone: [
          { file: 'todo-list', alt: '할일 목록 — 행마다 한 줄 잔디와 누적 시간' },
          { file: 'todo-detail', alt: '할일 상세 — 기간별 시간 타일과 기록 달력' },
        ],
        ipad: [
          { file: 'todo-list', alt: 'iPad 의 할일 목록' },
          { file: 'todo-detail', alt: 'iPad 의 할일 상세' },
        ],
      },
    },
    {
      label: 'Profiles',
      title: '누구 계획인지 섞이지 않습니다',
      lead: '아이가 여럿이거나 일과 개인 일정을 같이 챙기다 보면 누구 계획인지 섞이기 쉽습니다. 프로필을 나누면 화면에는 지금 고른 프로필의 할일과 일정만 나옵니다.',
      points: [
        '프로필마다 할일도 기록도 따로입니다. 오른쪽 위 아바타를 눌러 바로 바꿔 볼 수 있어요.',
        '어느 프로필을 펴 둘지는 기기마다 따로 기억합니다 — 아이 아이패드에는 그 아이 계획만 띄워 둘 수 있어요.',
        '안 쓰게 된 프로필은 보관합니다. 기록은 남고 알람은 멈추며, 언제든 다시 꺼낼 수 있어요.',
        '같은 Apple 계정이면 폰과 아이패드가 iCloud 로 알아서 맞춰집니다. 이 앱을 위해 만들 계정이나 로그인 화면은 없습니다.',
      ],
      shots: {
        iphone: [{ file: 'profiles', alt: '프로필 시트 — 개인·회사·집 프로필 전환' }],
        ipad: [{ file: 'profiles', alt: 'iPad 의 프로필 시트' }],
      },
    },
    {
      label: 'View',
      title: '달력은 펼쳐지고, 밤에는 어두워집니다',
      lead: '상단 날짜 줄을 펼치면 한 주가 한 달이 됩니다. 일정이 있는 날에는 점이 찍혀서, 어느 날이 비었는지 한 화면에서 보여요.',
      points: [
        '한 달을 펼친 채로도 날짜를 바로 고를 수 있고, 날을 넘겨도 보던 시각이 그대로 이어집니다.',
        '다크 모드는 시스템 설정을 따릅니다. 블록 색은 어두운 바탕에서도 같은 색으로 읽히게 맞춰 두었어요.',
        '홈 화면 위젯 둘 — 방금 끝난 일과 다음 할 일, 그리고 할일 하나의 잔디 — 은 앱을 열지 않아도 보입니다.',
      ],
      shots: {
        iphone: [
          { file: 'month', alt: '날짜 줄을 펼쳐 한 달로 본 플래너' },
          { file: 'dark', alt: '다크 모드의 하루 타임라인' },
        ],
        ipad: [
          { file: 'month', alt: 'iPad 에서 한 달로 펼친 날짜 줄' },
          { file: 'dark', alt: 'iPad 다크 모드의 하루 타임라인' },
        ],
      },
    },
  ],
};
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>
  <AppPage
    lang={lang}
    slug="planner"
    app={app}
    copy={copy}
    ipadShot="plain"
    shotSize={{ iphone: [720, 1564], ipad: [720, 960] }}
  />
</BaseLayout>
