---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BlogPostCard from '../../../../components/BlogPostCard.astro';
import { getLangFromUrl, useTranslations, postCountLabel } from '../../../../i18n/utils';
import { getCollection } from 'astro:content';
import { blogAppResolver, groupPostsByApp, tagsWithoutApp } from '../../../../lib/blog-apps';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const langPosts = allPosts.filter((post) => post.id.startsWith('ko/'));
  return groupPostsByApp(langPosts).map((group) => ({
    params: { app: group.key },
    props: { appKey: group.key, posts: group.posts },
  }));
}

const { appKey, posts } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const resolve = await blogAppResolver(lang);
const app = resolve(appKey);
---

<BaseLayout title={`${app.name} - ${t('blog.title')} - ${t('site.title')}`} lang={lang}>
  <div class="max-w-5xl w-full mx-auto px-6 py-24 md:py-36">
    <div class="text-center mb-16 md:mb-20">
      {app.icon && (
        <img src={app.icon} alt="" aria-hidden="true" width="256" height="256"
             class="app-icon w-16 h-16 md:w-20 md:h-20 mx-auto mb-5" />
      )}
      <h1 class="text-3xl md:text-4xl font-semibold text-text tracking-tight mb-3">{app.name}</h1>
      <p class="text-sm text-text-sub mb-6">{t('blog.appHeading')} · {postCountLabel(lang, posts.length)}</p>
      <div class="flex items-center justify-center gap-4 text-sm">
        {app.appHref && (
          <a href={app.appHref} class="text-primary hover:underline">{t('blog.viewApp')} →</a>
        )}
        <a href="/ko/blog" class="text-text-sub hover:text-text transition">{t('blog.viewAll')} →</a>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4">
      {posts.map((post) => (
        <BlogPostCard
          title={post.data.title}
          date={post.data.date}
          tags={tagsWithoutApp(post.data)}
          summary={post.data.summary}
          href={`/ko/blog/${post.id.replace('ko/', '')}`}
        />
      ))}
    </div>
  </div>
</BaseLayout>
