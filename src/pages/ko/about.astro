---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const about = (await getEntry('about', 'ko'))!;
---

<BaseLayout title={`${t('about.title')} - ${t('site.title')}`} description={about.data.description} lang={lang}>

  <style>
    .animate-reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .animate-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .section-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-primary);
      margin-bottom: 0.75rem;
    }

  </style>

  <!-- ── Header ── -->
  <div class="max-w-5xl w-full mx-auto px-6 pt-24 md:pt-36 pb-16 md:pb-24">
    <div class="max-w-xl animate-reveal">
      <span class="section-label">About</span>
      <h1 class="text-3xl md:text-4xl font-semibold text-text tracking-tight mb-4">
        Hyewon &amp; Insong
      </h1>
      <p class="text-base text-text-sub leading-relaxed">
        두 사람이 만드는 작은 모바일 스튜디오입니다.
        한국 판교에서 앱을 만들고 있습니다.
      </p>
    </div>
  </div>

  <!-- ── Support ── App Store 의 지원 URL 이 이 페이지다. 연락 수단이 반드시 보여야 한다. -->
  <section class="py-20 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-xl animate-reveal">
        <span class="section-label">Support</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">문의와 지원</h2>
        <p class="text-text-sub leading-relaxed mb-8">
          앱을 쓰다 막히는 곳이 있거나 고쳤으면 하는 것이 있으면 메일로 알려 주세요.
          어느 앱의 어느 화면인지 적어 주시면 더 빨리 찾습니다.
        </p>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href="mailto:contact@hyewoninsong.com" class="text-sm font-medium text-primary hover:underline">contact@hyewoninsong.com</a>
          <a href="/ko/privacy" class="text-sm font-medium text-primary hover:underline">개인정보처리방침 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Next ── -->
  <section class="py-20 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-xl animate-reveal">
        <span class="section-label">Next</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">만든 것과 그 과정</h2>
        <p class="text-text-sub leading-relaxed mb-8">
          지금 만들고 있는 앱과, 만들어 가는 과정을 기록합니다.
        </p>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href="/ko/apps" class="text-sm font-medium text-primary hover:underline">앱 보기 →</a>
          <a href="/ko/blog" class="text-sm font-medium text-primary hover:underline">개발 블로그 →</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.08, rootMargin: '0px 0px -24px 0px' }
  );
  document.querySelectorAll('.animate-reveal').forEach(el => observer.observe(el));
</script>
