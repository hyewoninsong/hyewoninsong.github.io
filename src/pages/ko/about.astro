---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const about = (await getEntry('about', 'ko'))!;

const principles = [
  {
    title: "손이 먼저",
    desc: "폼을 채우는 대신 손으로 바로 만집니다. 설명서를 읽지 않아도 첫 화면에서 손이 알아서 움직이도록.",
  },
  {
    title: "꼭 필요한 만큼만",
    desc: "고를 게 적을수록 빨리 끝납니다. 있어야 할 이유가 분명한 것만 남기고, 나머지는 덜어냅니다.",
  },
  {
    title: "실수해도 괜찮게",
    desc: "언제든 되돌릴 수 있고, 다 만든 건 잠가둘 수 있습니다. 마음 놓고 만져볼 수 있어야 편한 도구니까요.",
  },
];
---

<BaseLayout title={`${t('about.title')} - ${t('site.title')}`} description={about.data.description} lang={lang}>

  <style>
    .animate-reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .animate-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .delay-1 { transition-delay: 0.06s; }
    .delay-2 { transition-delay: 0.12s; }
    .delay-3 { transition-delay: 0.18s; }

    .section-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-primary);
      margin-bottom: 0.75rem;
    }

    .mono-index {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      color: var(--color-primary);
    }

    .pillar-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .pillar-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.07);
    }
  </style>

  <!-- ── Header ── -->
  <div class="max-w-5xl w-full mx-auto px-6 pt-24 md:pt-36 pb-16 md:pb-24">
    <div class="max-w-xl animate-reveal">
      <span class="section-label">About</span>
      <h1 class="text-3xl md:text-4xl font-semibold text-text tracking-tight mb-4">
        Hyewon &amp; Insong
      </h1>
      <p class="text-base text-text-sub leading-relaxed">
        두 사람이 만드는 작은 모바일 스튜디오입니다.
        매일 쓰는 도구에서 번거로운 부분을 덜어내, 설명 없이도 바로 쓰이는 앱을 만듭니다.
      </p>
    </div>
  </div>

  <!-- ── Principles ── -->
  <section class="py-20 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto">
      <div class="mb-12 animate-reveal">
        <span class="section-label">Principles</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight">앱을 만들 때 지키는 것</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-5">
        {principles.map((p, i) => (
          <div class={`pillar-card animate-reveal delay-${i + 1} bg-card border border-border rounded-2xl p-7`}>
            <span class="mono-index block mb-3">0{i + 1}</span>
            <h3 class="text-sm font-semibold text-text mb-2">{p.title}</h3>
            <p class="text-sm text-text-sub leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Next ── -->
  <section class="py-20 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-xl animate-reveal">
        <span class="section-label">Next</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">만든 것과 배운 것</h2>
        <p class="text-text-sub leading-relaxed mb-8">
          지금 만들고 있는 앱과, 만들면서 배운 것들을 기록합니다.
        </p>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href="/ko/apps" class="text-sm font-medium text-primary hover:underline">앱 보기 →</a>
          <a href="/ko/blog" class="text-sm font-medium text-primary hover:underline">개발 블로그 →</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.08, rootMargin: '0px 0px -24px 0px' }
  );
  document.querySelectorAll('.animate-reveal').forEach(el => observer.observe(el));
</script>
