---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'en/timetable'))!;

const { platforms = {} } = app.data;
const hasIOS = platforms.iphone || platforms.ipad || platforms.mac;
const hasAndroid = !!platforms.android;

const badgeClass = (status: 'released' | 'in-development') =>
  status === 'released'
    ? 'border-green-200 bg-green-50 text-green-700'
    : 'border-border bg-muted text-muted-foreground';

const statusLabel = (status: 'released' | 'in-development') =>
  status === 'released' ? t('status.released') : t('status.dev');

const img = (name: string) => `/apps/timetable/en/${name}.png`;
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>

  <style>
    .animate-reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .animate-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .delay-1 { transition-delay: 0.06s; }
    .delay-2 { transition-delay: 0.12s; }
    .delay-3 { transition-delay: 0.18s; }

    .screenshot {
      border-radius: 2.5rem;
      box-shadow: 0 20px 60px rgba(0,0,0,0.12), 0 4px 16px rgba(0,0,0,0.08);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      display: block;
    }
    .screenshot:hover {
      transform: scale(1.02) translateY(-2px);
      box-shadow: 0 28px 72px rgba(0,0,0,0.16), 0 6px 20px rgba(0,0,0,0.1);
    }

    .section-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-primary);
      margin-bottom: 0.75rem;
    }

    .screenshot-pair {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding: 0.5rem 0;
    }
    .screenshot-pair::-webkit-scrollbar { display: none; }
    .screenshot-pair img { flex-shrink: 0; }

    .step-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }
    .step-list li {
      display: flex;
      gap: 0.75rem;
      font-size: 0.875rem;
      color: var(--color-text-sub);
      line-height: 1.6;
    }
    .step-list li span:first-child {
      flex-shrink: 0;
      font-weight: 600;
      color: var(--color-text);
      min-width: 4.5rem;
    }

    .mini-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .mini-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.08);
    }
    .mini-card img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      object-position: top;
    }
    .mini-card img.from-bottom { object-position: bottom; }
  </style>

  <div class="max-w-5xl w-full mx-auto px-6 py-24 md:py-36">

    <!-- ── Header ── -->
    <div class="text-center mb-20 md:mb-28 animate-reveal">
      <h1 class="text-3xl md:text-4xl font-semibold text-text tracking-tight mb-3">{app.data.title}</h1>
      <p class="text-base text-text-sub mb-6 max-w-md mx-auto">{app.data.summary}</p>

      <div class="flex flex-col items-center gap-2">
        {hasIOS && (
          <div class="flex items-center gap-2 flex-wrap justify-center">
            <span class="flex items-center gap-1 text-xs text-text-sub w-16 justify-end shrink-0">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 shrink-0">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
              </svg>
              iOS
            </span>
            <div class="flex gap-1.5 flex-wrap justify-center">
              {platforms.iphone && (
                <span class:list={['inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-medium', badgeClass(platforms.iphone)]}>
                  iPhone · {statusLabel(platforms.iphone)}
                </span>
              )}
              {platforms.ipad && (
                <span class:list={['inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-medium', badgeClass(platforms.ipad)]}>
                  iPad · {statusLabel(platforms.ipad)}
                </span>
              )}
            </div>
          </div>
        )}
        {hasAndroid && (
          <div class="flex items-center gap-2 justify-center">
            <span class="flex items-center gap-1 text-xs text-text-sub w-16 justify-end shrink-0">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 shrink-0">
                <path d="M17.523 15.341a.985.985 0 01-.984-.984.985.985 0 01.984-.984.985.985 0 01.984.984.985.985 0 01-.984.984m-11.046 0a.985.985 0 01-.984-.984.985.985 0 01.984-.984.985.985 0 01.984.984.985.985 0 01-.984.984m11.405-6.022l1.969-3.411a.41.41 0 00-.149-.559.41.41 0 00-.559.149l-1.994 3.454A11.774 11.774 0 0012 8.098c-1.73 0-3.364.393-4.799 1.084L5.207 5.698a.41.41 0 00-.559-.149.41.41 0 00-.149.559l1.969 3.411C3.945 10.878 2.5 13.239 2.5 15.898h19c0-2.659-1.445-5.02-3.618-6.579z"/>
              </svg>
              Android
            </span>
            <span class:list={['inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-medium', badgeClass(platforms.android!)]}>
              {statusLabel(platforms.android!)}
            </span>
          </div>
        )}
      </div>

      {app.data.appStoreUrl && (
        <a href={app.data.appStoreUrl} target="_blank" rel="noopener noreferrer"
           class="inline-block mt-5 text-sm text-primary hover:underline">
          App Store →
        </a>
      )}
    </div>

    <!-- ── Intro screenshot ── -->
    <div class="flex justify-center mb-28 animate-reveal delay-1">
      <img
        src={img('hero')}
        alt="SuperTimetable weekly grid with color-coded schedule blocks"
        class="screenshot w-full max-w-[300px]"
      />
    </div>

  </div>

  <!-- ── Section: Drag & Gestures ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Drag & Gestures</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">Build your schedule with your hands</h2>
        <p class="text-text-sub leading-relaxed">
          No forms, no date pickers. Every schedule block is created, moved, and resized
          directly on the grid, with a live time label that follows your finger.
        </p>
        <ul class="step-list">
          <li><span>Create</span><span>Drag across empty space. Drag up or down and the block grows in either direction.</span></li>
          <li><span>Move</span><span>Pick up a block and drop it on another day or time. A haptic tick marks every minute you pass.</span></li>
          <li><span>Resize</span><span>Pull the top or bottom handle to change only that edge.</span></li>
        </ul>
        <p class="text-text-sub leading-relaxed mt-5">
          Guide lines appear at the edges of nearby blocks so you can snap precisely to them,
          and the grid scrolls on its own when you reach the top or bottom.
        </p>
      </div>
      <div class="flex-1 screenshot-pair animate-reveal delay-1">
        <img src={img('drag-create')} alt="Creating a block by dragging across empty cells" class="screenshot w-full max-w-[200px]" />
        <img src={img('move-drag')} alt="Moving a block to another day with live time labels" class="screenshot w-full max-w-[200px]" />
        <img src={img('resize-drag')} alt="Resizing a block by pulling its bottom handle" class="screenshot w-full max-w-[200px]" />
      </div>
    </div>
  </section>

  <!-- ── Section: Edit Sheet ── -->
  <section class="py-24 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Edit Sheet</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">Everything about a block, in one place</h2>
        <p class="text-text-sub leading-relaxed mb-4">
          Tap a block to open a calendar-style sheet. Title, color, days, and time sit at the top.
          Below them, two alarms and a memo, so the block carries everything you need to remember.
        </p>
        <p class="text-text-sub leading-relaxed mb-4">
          Alarms fire at the start, or 5 minutes to 2 hours before, with a choice of five sounds.
          Set a second alarm when one reminder is not enough.
        </p>
        <p class="text-text-sub leading-relaxed">
          Pick from 10 basic colors or build your own with the custom color editor.
          Change a custom color later and every block using it updates across all your timetables.
        </p>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('quick-edit')} alt="Edit sheet with title, color, days, time, alarm, and memo" class="screenshot w-full max-w-[220px]" />
        <img src={img('color-variant')} alt="Same block with a different color applied" class="screenshot w-full max-w-[220px]" />
      </div>
    </div>
  </section>

  <!-- ── Section: Batch Update ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Batch Update</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">Change one, update them all</h2>
        <p class="text-text-sub leading-relaxed mb-4">
          Blocks that share a title and color count as the same style. Rename or recolor one of them
          and SuperTimetable asks whether the other matching blocks should follow, with a before-and-after
          preview so you know exactly what changes.
        </p>
        <p class="text-text-sub leading-relaxed">
          Only the title and color are updated. Days, times, memos, and alarms on each block stay as they were.
        </p>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('batch-edit')} alt="Confirmation sheet offering to update matching blocks" class="screenshot w-full max-w-[220px]" />
        <img src={img('batch-edit-after')} alt="Grid after every matching block took the new title and color" class="screenshot w-full max-w-[220px]" />
      </div>
    </div>
  </section>

  <!-- ── Section: Custom View ── -->
  <section class="py-24 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Custom View</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">Show only what matters to you</h2>
        <p class="text-text-sub leading-relaxed mb-4">
          Each timetable keeps its own view settings. Show weekdays only, add Saturday, or the full week,
          and start the week on Monday or Sunday.
        </p>
        <p class="text-text-sub leading-relaxed mb-4">
          Drag the hour slider to display anything from a single morning to all 24 hours,
          so the hours you actually use fill the screen.
        </p>
        <p class="text-text-sub leading-relaxed">
          Switch between 12-hour and 24-hour time, and choose light, dark, or automatic appearance.
          Lock the grid when you are done editing to keep taps from moving anything.
        </p>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('day-range')} alt="Timetable showing a custom day range" class="screenshot w-full max-w-[220px]" />
        <img src={img('dark-mode')} alt="Timetable in dark mode" class="screenshot w-full max-w-[220px]" />
      </div>
    </div>
  </section>

  <!-- ── Section: Widgets ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Widgets</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">Your schedule, always visible</h2>
        <p class="text-text-sub leading-relaxed mb-4">
          The Week widget puts the whole grid on your Home Screen in large or extra-large size,
          with the current day and time highlighted.
        </p>
        <p class="text-text-sub leading-relaxed mb-4">
          The Today widget shows a timeline centered on the current moment, in every size from small
          to extra large. Tap it to jump straight into the app.
        </p>
        <p class="text-text-sub leading-relaxed">
          Choose which timetable each widget shows. Both follow your system appearance and your 12-hour
          or 24-hour preference.
        </p>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('widget-light')} alt="Home Screen with the Week and Today widgets in light mode" class="screenshot w-full max-w-[220px]" />
        <img src={img('widget-dark')} alt="Home Screen with the Week and Today widgets in dark mode" class="screenshot w-full max-w-[220px]" />
      </div>
    </div>
  </section>

  <!-- ── Section: Share & Print ── -->
  <section class="py-24 px-6 bg-bg-alt border-t border-border">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="flex-1 animate-reveal">
        <span class="section-label">Share & Print</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">On screen, on paper, or on another device</h2>
        <p class="text-text-sub leading-relaxed mb-4">
          Export a clean image of your timetable in light or dark, in 12-hour or 24-hour time,
          with a live preview before you share it.
        </p>
        <p class="text-text-sub leading-relaxed mb-4">
          Print straight from the app. Choose A3 to Letter or a custom paper size, portrait or landscape,
          fit or fill, and put 1, 2, or 4 timetables on a page. Pinch to zoom the preview to check every detail.
        </p>
        <p class="text-text-sub leading-relaxed">
          Share a timetable as a file to back it up or hand it to someone else.
          Anyone with SuperTimetable opens it as a ready-to-edit copy.
        </p>
      </div>
      <div class="flex-1 screenshot-pair justify-center animate-reveal delay-1">
        <img src={img('image-share')} alt="Share sheet with light and dark image preview" class="screenshot w-full max-w-[220px]" />
        <img src={img('print')} alt="Print options with paper size, orientation, and copies per page" class="screenshot w-full max-w-[220px]" />
      </div>
    </div>
  </section>

  <!-- ── More Features ── -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14 animate-reveal">
        <span class="section-label">More</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight">Every detail, considered</h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <div class="mini-card animate-reveal delay-1 bg-card border border-border rounded-2xl overflow-hidden">
          <img src={img('timetable-list')} alt="Timetable list with full-size previews" />
          <div class="p-5">
            <h3 class="text-sm font-semibold text-text mb-1.5">Multiple Timetables</h3>
            <p class="text-xs text-text-sub leading-relaxed">
              Keep one per semester, job, or family member. Swipe through full-size previews and switch in one tap.
            </p>
          </div>
        </div>

        <div class="mini-card animate-reveal delay-2 bg-card border border-border rounded-2xl overflow-hidden">
          <img src={img('duplicate-timetable')} alt="Duplicating a timetable from the list" />
          <div class="p-5">
            <h3 class="text-sm font-semibold text-text mb-1.5">Duplicate a Timetable</h3>
            <p class="text-xs text-text-sub leading-relaxed">
              Start a new semester from last one. Duplicate the whole timetable, rename it, and adjust only what changed.
            </p>
          </div>
        </div>

        <div class="mini-card animate-reveal delay-3 bg-card border border-border rounded-2xl overflow-hidden">
          <img src={img('title-suggestions')} alt="Copy Style From list showing existing title and color pairs" />
          <div class="p-5">
            <h3 class="text-sm font-semibold text-text mb-1.5">Copy Style From</h3>
            <p class="text-xs text-text-sub leading-relaxed">
              Adding another Math class? Pick an existing title and color pair from the list, most used first, instead of typing it again.
            </p>
          </div>
        </div>

        <div class="mini-card animate-reveal delay-1 bg-card border border-border rounded-2xl overflow-hidden">
          <img src={img('undo-redo')} alt="Undo and redo buttons in the bottom toolbar" class="from-bottom" />
          <div class="p-5">
            <h3 class="text-sm font-semibold text-text mb-1.5">Unlimited Undo & Redo</h3>
            <p class="text-xs text-text-sub leading-relaxed">
              Every timetable keeps its own history. Moves, resizes, edits, and deletions are all reversible, with no depth limit.
            </p>
          </div>
        </div>

        <div class="mini-card animate-reveal delay-2 bg-card border border-border rounded-2xl overflow-hidden">
          <img src={img('lock-toggle')} alt="Locked timetable with the lock button in the corner" class="from-bottom" />
          <div class="p-5">
            <h3 class="text-sm font-semibold text-text mb-1.5">Lock When Done</h3>
            <p class="text-xs text-text-sub leading-relaxed">
              One tap locks the grid so nothing moves by accident. Tap a block while locked to just read its details.
            </p>
          </div>
        </div>

        <div class="mini-card animate-reveal delay-3 bg-card border border-border rounded-2xl p-6">
          <h3 class="text-sm font-semibold text-text mb-1.5">Guided First Run</h3>
          <p class="text-xs text-text-sub leading-relaxed mb-4">
            A short interactive tutorial walks you through creating, moving, resizing, and locking on a sample timetable. Skip it anytime, replay it from the menu.
          </p>
          <h3 class="text-sm font-semibold text-text mb-1.5">iPhone and iPad</h3>
          <p class="text-xs text-text-sub leading-relaxed">
            On iPad, a side panel edits blocks next to the grid. Available in English, Korean, Japanese, and Simplified and Traditional Chinese.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Back ── -->
  <div class="max-w-5xl mx-auto px-6 py-12 border-t border-border">
    <a href="/en/apps" class="text-sm text-text-sub hover:text-text transition">← {t('apps.title')}</a>
  </div>

</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.08, rootMargin: '0px 0px -24px 0px' }
  );
  document.querySelectorAll('.animate-reveal').forEach(el => observer.observe(el));
</script>
