---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppPage, { type Copy } from '../../../components/AppPage.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'en/timetable'))!;

const copy: Copy = {
  tagline: 'A timetable you draw by hand',
  summary: 'Put the week already in your head straight onto the screen. Drag to draw it, glance at it on your Home Screen, pin it to a wall.',
  hero: { iphone: 'SuperTimetable weekly grid on iPhone', ipad: 'SuperTimetable weekly grid on iPad' },
  tabs: { iphone: 'iPhone', ipad: 'iPad' },
  closing: ['Your timetables stay on the device.', 'No account, no sign-in.'],
  sections: [
    {
      label: 'Just Drag',
      title: 'Create, move, and resize. Just drag.',
      lead: {
        iphone: 'Drag across an empty slot and the class appears right there. There is nothing to type into a form. A time label follows your finger and a tap of haptic feedback tells you where you landed.',
        ipad: 'Drag across an empty slot and the class appears right there. There is nothing to type into a form. A time label follows your finger and tells you where you landed.',
      },
      steps: [
        ['Create', 'Swipe up or down over empty space and a block fills exactly that much.'],
        ['Move', 'Pick up a block and drop it on another day. The day and time travel with it, so nothing has to be deleted and remade.'],
        ['Resize', 'Pull one end and only that end changes. When an exact value matters, set it in the edit screen.'],
      ],
      shots: {
        iphone: [
          { file: 'drag-create', alt: 'Dragging across empty space to create a class' },
          { file: 'move-drag', alt: 'Moving a block to another day with the time label following' },
          { file: 'resize-drag', alt: 'Pulling the bottom handle to extend a class' },
        ],
        ipad: [
          { file: 'drag-create', alt: 'Dragging across empty space on the iPad grid to create a class' },
        ],
      },
    },
    {
      label: 'Undo & Lock',
      title: 'A layout you can keep changing',
      lead: 'A timetable is never right the first time. Most of the work is moving, stretching, and moving again, so the changing itself is made light.',
      points: [
        'Guide lines appear on neighboring blocks as you drag, so nothing ends up a few minutes out of line.',
        'Undo and redo have no limit, so you can rearrange as freely as you like.',
        'Lock a finished timetable and you will never nudge it while you are only looking.',
      ],
      shots: {
        iphone: [
          { file: 'undo-redo', alt: 'Undoing a move from the bottom toolbar' },
          { file: 'lock', alt: 'Lock indicator on a locked timetable' },
        ],
        ipad: [
          { file: 'lock', alt: 'Lock indicator on a locked timetable on iPad' },
        ],
      },
    },
    {
      label: 'Batch Edit',
      title: 'One edit that covers every repeat',
      lead: 'If the same class meets three times a week, that is three places to rename. Blocks sharing a title and color are one group, so changing one asks whether to change the rest.',
      points: [
        'Before and after sit side by side, so nothing changes without you seeing it first.',
        'Each block keeps its own day, time, note, and alarms.',
      ],
      shots: {
        iphone: [
          { file: 'batch-edit', alt: 'Confirmation asking whether to change matching classes together' },
          { file: 'batch-edit-after', alt: 'Grid with every matching class renamed and recolored' },
        ],
        ipad: [
          { file: 'batch-edit', alt: 'Confirmation on iPad asking whether to change matching classes together' },
        ],
      },
    },
    {
      label: 'Your Style',
      title: 'Pick any colour and name',
      lead: 'Every title and color you have used stays in a list, so adding the same class again is a matter of picking it. If none of the colors is right, make your own.',
      points: [
        'Colors you make stay in your own palette, ready for the next class.',
        'One color per subject, and the week sorts itself by color.',
      ],
      shots: {
        iphone: [
          { file: 'style-sheet', alt: 'Style list of titles and colors already in use' },
          { file: 'custom-color-picker', alt: 'Color editor for making your own color' },
          { file: 'custom-color', alt: 'Style list with a custom color added' },
        ],
        ipad: [
          { file: 'style-sheet', alt: 'Style popover anchored to the color circle on iPad' },
        ],
      },
    },
    {
      label: 'Display',
      title: 'A day only as long as yours',
      lead: 'Hours you never use take up the room the ones you do need. Narrow the days and hours shown, per timetable, and the time you actually use fills the screen.',
      points: [
        'The first day of the week and the clock format stay the way you already read them.',
        'Widen to the weekend or keep weekdays only, decided per timetable.',
      ],
      shots: {
        iphone: [
          { file: 'display-settings', alt: 'Display settings sheet for days and hour range' },
        ],
        ipad: [
          { file: 'display-settings', alt: 'Display settings on iPad' },
          { file: 'day-range', alt: 'Timetable widened to include Sunday on iPad' },
        ],
      },
    },
    {
      label: 'Dark Mode',
      title: 'Easy on the eyes at night',
      lead: 'Let the appearance follow the room, or keep it the way you always see it. Colors stay just as clear on a dark screen, so tomorrow\'s first class is readable with the lights off.',
      shots: {
        iphone: [
          { file: 'dark-mode', alt: 'Timetable in dark mode' },
        ],
        ipad: [
          { file: 'dark-mode', alt: 'Timetable in dark mode on iPad' },
        ],
      },
    },
    {
      label: 'Alarms & Edit',
      title: 'Get reminded before each class',
      lead: 'The time to get ready and the time to start are not the same. Put up to two alarms on one class, so preparing and starting reach you separately.',
      points: {
        iphone: [
          'Hear an alarm sound before you choose it, so nothing rings as a surprise.',
          'Title, color, time, alarms, and a note all live on one screen, so whatever you need to remember stays inside the class.',
        ],
        ipad: [
          'Hear an alarm sound before you choose it, so nothing rings as a surprise.',
          'Editing happens in a panel beside the block. No sheet covers the grid, so you see the whole week while you change one class.',
        ],
      },
      shots: {
        iphone: [
          { file: 'alarm', alt: 'Schedule editor with two alarms set' },
          { file: 'quick-edit', alt: 'Schedule editor with title, days, time, alarm, and note' },
        ],
        ipad: [
          { file: 'alarm', alt: 'Edit panel on iPad with two alarms set' },
          { file: 'edit-panel', alt: 'Edit panel beside the block on iPad' },
        ],
      },
    },
    {
      label: 'Widgets',
      title: 'The next class without opening the app',
      lead: 'Opening an app just to check is the part you stop doing.',
      points: [
        'The home screen widget shows the whole week; the today widget shows a timeline centered on right now.',
        'The lock screen widget names the one class coming next.',
        'Choose which timetable each widget shows, so only what matters today is on screen.',
      ],
      shots: {
        iphone: [
          { file: 'widget-light', alt: 'Week and Today widgets on a light home screen' },
          { file: 'widget-dark', alt: 'Week and Today widgets on a dark home screen' },
        ],
        ipad: [
          { file: 'widget-light', alt: 'Week and Today widgets on an iPad home screen' },
          { file: 'widget-dark', alt: 'Week and Today widgets on a dark iPad home screen' },
        ],
      },
    },
    {
      label: 'Share & Print',
      title: 'As a picture, a file, or on paper',
      lead: 'Some timetables end up on a wall, others in someone else\'s hands.',
      points: {
        iphone: [
          'Choose the paper size and orientation and print straight from the app, crisp and in the same colors as the screen.',
          'Export an image, with the preview changing as you pick each setting, so you see it before you send it.',
          'Share a file to keep a backup, and whoever receives it opens an editable copy and carries on.',
        ],
        ipad: [
          'Options sit in their own column on the right, so you choose while looking at a large preview.',
          'Choose the paper size and orientation and print straight from the app, crisp and in the same colors as the screen.',
          'Share a file to keep a backup, and whoever receives it opens an editable copy and carries on.',
        ],
      },
      shots: {
        iphone: [
          { file: 'image-share', alt: 'Share screen with a live preview' },
          { file: 'print', alt: 'Print preview showing the timetable on the page' },
        ],
        ipad: [
          { file: 'image-share', alt: 'Share screen on iPad with the preview and an options column' },
          { file: 'print', alt: 'Print screen on iPad with the page preview and an options column' },
        ],
      },
    },
    {
      label: 'Timetable List',
      title: 'Every timetable in one app',
      lead: 'Even one person has several weeks to keep track of. Keep separate timetables for each semester and each person at home.',
      points: [
        'Start a new semester by duplicating the last one and changing only what moved.',
        'Flip through the previews and switch with a single tap.',
      ],
      shots: {
        iphone: [
          { file: 'timetable-list', alt: 'Timetable list with swipeable previews' },
        ],
        ipad: [
          { file: 'timetable-list', alt: 'Timetable list floating over the grid on iPad' },
        ],
      },
    },
  ],
};
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>
  <AppPage lang={lang} slug="timetable" app={app} copy={copy} />
</BaseLayout>
