---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppPage, { type Copy } from '../../../components/AppPage.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'en/superfont'))!;

const copy: Copy = {
  tagline: 'An iPhone that uses the fonts you bought',
  summary: 'Typefaces that have been sitting in your downloads start showing up in Notes, in documents, in slides.',
  hero: {
    iphone: 'Installed fonts, each row drawn in its own typeface (iPhone)',
    ipad: 'Installed fonts, each row drawn in its own typeface (iPad)',
  },
  tabs: { iphone: 'iPhone', ipad: 'iPad' },
  closing: ['Your font files and install history stay on the device.', 'No account, no sign-in.'],
  sections: [
    {
      label: 'Import',
      title: 'Take the files exactly as they came',
      lead: 'Buying or downloading a typeface is easy. Getting it onto an iPhone is where it stops — there is barely a way to even open the file. Drop in what the foundry sent you, unedited, with no detour through a Mac.',
      steps: [
        ['ZIP as-is', 'Add the archive without unpacking it and the typefaces inside are found for you. No round trip through the Files app.'],
        ['No duplicates', 'When the same typeface arrives as both TTF and OTF, one is kept. Your font list does not fill up with the same name twice.'],
        ['Sorted out early', 'Files that cannot be installed are set aside with the reason up front, instead of failing at the end of the process.'],
      ],
      shots: {
        iphone: [{ file: 'import', alt: '13 families and 17 styles found inside a single ZIP' }],
        ipad: [{ file: 'import', alt: 'A single ZIP loaded on iPad' }],
      },
    },
    {
      label: 'Browse',
      title: 'Finding something new, without leaving the app',
      lead: 'Font hunting usually starts in a browser and ends in file management — downloading, unzipping, then looking for where it went. That whole errand moves inside the app.',
      points: [
        'Thousands of free typefaces are there to flip through, right where you install them.',
        'Narrow to handwriting or monospace only, or to a language, and stop scrolling past what you will not use.',
        'Whether a font covers your language is shown in the list, so nothing breaks once you actually use it.',
        'When one catches your eye, installing it continues right there — no browser, no download folder.',
      ],
      shots: {
        iphone: [
          { file: 'browse', alt: 'Free fonts narrowed down by category and language' },
          { file: 'browse-search', alt: 'A font found by name, with language coverage shown' },
        ],
        ipad: [
          { file: 'browse', alt: 'Free fonts narrowed down by category on iPad' },
          { file: 'browse-search', alt: 'A font found by name on iPad' },
        ],
      },
    },
    {
      label: 'Preview',
      title: 'Choose with your eyes, before installing',
      lead: 'A font picked by name turns out wrong only once it is in the document. The list you are about to install draws every typeface in itself.',
      points: [
        'Push the size up and you can tell whether it holds as a heading or stays readable as body text.',
        'Put your own words in the preview and you catch a font missing the characters you need before it reaches a document.',
        'Anything already on the device is marked as installed, so you do not add it twice.',
        'Take one weight out of a family, or bundle more than a dozen fonts — either way the install happens once.',
      ],
      shots: {
        iphone: [{ file: 'preview', alt: 'Fonts about to be installed, each drawn in its own typeface' }],
        ipad: [{ file: 'preview', alt: 'Fonts about to be installed, shown on iPad' }],
      },
    },
    {
      label: 'Profile',
      title: 'A profile you never have to build',
      lead: 'iOS does not let an app install a system font. It wants a configuration profile instead — the kind of file an IT administrator normally hand-builds for a company device, and one that is refused outright if its structure is even slightly off.',
      points: [
        'The profile is generated around the typefaces you picked, so its internals stay none of your business.',
        'The name Settings will display is filled in ahead of time, so you can find it again months later.',
        'Several fonts go into a single profile. You are not repeating the same errand for each one.',
      ],
      shots: {
        iphone: [{ file: 'profile', alt: 'Download step with the selected fonts and a pre-filled profile name' }],
        ipad: [{ file: 'profile', alt: 'The profile download step on iPad' }],
      },
    },
    {
      label: 'Guide',
      title: 'An install that does not strand you',
      lead: 'Installing means crossing between Safari and Settings, and a "not signed" warning shows up partway through. That warning is where most people quit.',
      steps: [
        ['Real screens', 'Every step is shown as a picture of the actual screen, so you are never hunting for the next button.'],
        ['Warning explained', 'Why that warning is normal is explained right where it appears, so second-guessing does not stop you halfway.'],
        ['Picks up for you', 'Finish in Settings, come back, and the app moves on by itself. You do not have to remember where you left off.'],
      ],
      shots: {
        iphone: [
          { file: 'guide-safari', alt: 'Where to tap Allow in Safari, shown on the real screen' },
          { file: 'guide-install', alt: 'The seven things to do in Settings, listed in order' },
          { file: 'guide-settings', alt: 'Where the Install button sits in Settings, shown on the real screen' },
        ],
        ipad: [
          { file: 'guide-install', alt: 'The things to do in Settings, listed on iPad' },
          { file: 'guide-settings', alt: 'Where the Install button sits, shown on iPad' },
        ],
      },
    },
    {
      label: 'My Fonts',
      title: 'Knowing what is actually installed',
      lead: 'A week after installing, nobody remembers which fonts made it onto the device. The list is built so you never have to guess at the current state.',
      points: [
        'Installed and not-yet-installed sit in one list, clearly apart.',
        'Every row is drawn in its own typeface, so you read the shape instead of the name.',
        'Expand a family and you see which weights actually landed.',
        'Search by name, filter by installed or not — dozens in, you still get to the one you want in a moment.',
      ],
      shots: {
        iphone: [{ file: 'my-fonts', alt: 'A family expanded to show which weights are installed' }],
        ipad: [{ file: 'my-fonts', alt: 'The font list on iPad' }],
      },
    },
    {
      label: 'Reinstall',
      title: 'When they disappear, you do not start over',
      lead: 'Reset the device or delete the profile and the fonts go with it. Remembering where the original files came from is the next problem.',
      points: [
        'The files you installed are kept, so you pick out the ones that vanished and bring them back in one go.',
        'Fonts you no longer want go from the same screen.',
        'Nothing to re-download, and no folder to remember.',
      ],
      shots: {
        iphone: [{ file: 'reinstall', alt: 'Several fonts selected for reinstalling or removal' }],
        ipad: [{ file: 'reinstall', alt: 'Several fonts selected for reinstalling on iPad' }],
      },
    },
  ],
};

const footerLinks = [
  { href: '/en/apps/superfont/support/', label: 'Support' },
  { href: '/en/apps/superfont/privacy/', label: 'Privacy Policy' },
];
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>
  <AppPage
    lang={lang}
    slug="superfont"
    app={app}
    copy={copy}
    ipadShot="plain"
    shotSize={{ iphone: [720, 1564], ipad: [720, 960] }}
    footerLinks={footerLinks}
  />
</BaseLayout>
