---
/**
 * SuperPlanner page. Screenshots are the raw captures from the app repo's capture tests
 * (`todoUITests/AppStoreScreenshots` · `AppStoreIPadScreenshots`), copied by `web-app-page/scripts/collect-shots.sh`
 * into `public/apps/planner/{ko,en}/` and `…/ipad/`. `list-view` is not in the store set — an extra capture of the
 * list view added after ADR-0114. iPad captures are portrait → `ipadShot="plain"`, 720×960.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppPage, { type Copy } from '../../../components/AppPage.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'en/planner'))!;

const copy: Copy = {
  tagline: 'Plan your day by the hour',
  summary: 'A plan without an hour on it is only an intention. Put what you mean to do onto the hours of the day, and drag it when the day goes differently.',
  hero: { iphone: 'SuperPlanner day timeline (iPhone)', ipad: 'SuperPlanner day timeline (iPad)' },
  tabs: { iphone: 'iPhone', ipad: 'iPad' },
  closing: ['Your plan lives on your device and in your own iCloud, and the names and notes you write are never sent anywhere.', 'There is no account to create and no sign-in screen.'],
  sections: [
    {
      label: 'Plan',
      title: 'Drag an empty stretch and that is when it happens',
      lead: 'Writing something down and deciding when to do it are two different jobs, and a list only ever does the first. Here you drag across an empty stretch of the day and that stretch becomes the time for it.',
      steps: [
        ['Drag a range', 'The span is drawn as you hold and pull, so you never pass through a screen that asks for a time.'],
        ['Release to pick', 'Letting go brings up the todos you already keep. The one you pick lands in that span and is selected right away.'],
        ['Or make one there', 'A todo that does not exist yet is typed into the search field and created on the spot, without opening the todo list first.'],
      ],
      shots: {
        iphone: [
          { file: 'drag-create', alt: 'Dragging across an empty stretch to draw a new block' },
          { file: 'todo-picker', alt: 'The todo picker that comes up when you let go' },
        ],
        ipad: [{ file: 'hero', alt: 'The day timeline on iPad' }],
      },
    },
    {
      label: 'All-day',
      title: 'Some things only need a day, not an hour',
      lead: 'A journal entry or a set of vocabulary only matters as "done today", and giving it a time slot is busywork. Flip the timeline/list toggle at the top to the list view, add it to the day as all-day, and check it off when it is done.',
      points: [
        'The + at the bottom right adds a todo to that day. The same todo can sit on the timeline one day and be all-day the next.',
        'Every row carries its last seven days, so the place you check it off is also where you see the run you are keeping.',
        'Below, the Schedule section lists that day\'s timed blocks in order. Tap one and the timeline opens on that block.',
        'While you are on the timeline, the list button shows how many all-day items are still unchecked, so nothing you added gets forgotten.',
      ],
      shots: {
        iphone: [{ file: 'list-view', alt: 'The list view: all-day todos with a seven-day strip on top, the day\'s schedule below' }],
        ipad: [{ file: 'list-view', alt: 'The list view on iPad' }],
      },
    },
    {
      label: 'Adjust',
      title: 'When the day goes differently, you drag',
      lead: 'A day does not go as planned. Things slip, move up, and slip again. A block moves when you drag it and stretches when you grab its edge, so nothing has to be deleted and made again.',
      points: [
        'Edges snap to neighbouring blocks, and while you drag a ruler shows the time left to the next one, so you are not working out the exact minute.',
        'Overlapping is allowed and nothing is asked about it. Only the overlapping stretch is hatched, and untangling it stays your call.',
        'Anything you do comes back from the undo button in the bottom left, fifty steps deep.',
        'When you only want to look, the lock in the bottom left makes the day read-only. You can still tap a block and read its note; you just cannot knock it out of place.',
      ],
      shots: {
        iphone: [{ file: 'move-drag', alt: 'A block held mid-drag on its way to a new time' }],
        ipad: [{ file: 'group-link', alt: 'A selected block on iPad, with its link chips and resize handle' }],
      },
    },
    {
      label: 'Shift',
      title: 'When one thing slips, everything after it does too',
      lead: 'A meeting runs half an hour long and the rest of the day moves with it. Dragging blocks one at a time is how the order gets scrambled. Select a block, tap the chip below it, and everything after it is linked into one run you drag once.',
      points: [
        'The upper chip links everything before the block, the lower one everything after. A solid chip means all of that side is linked, a faint one means some of it.',
        'Anything that should stay put is unlinked with the link button on its own block, so the rest still moves.',
        'A linked block that runs into something standing still stops against it — a run never leaves new overlaps in its wake.',
        'Ten blocks moved, one undo.',
      ],
      shots: {
        iphone: [
          { file: 'group-link', alt: 'The lower chip tapped: every block after it is linked into one run' },
          { file: 'group-drag', alt: 'The linked run held mid-drag, all of it moving together' },
        ],
        ipad: [{ file: 'group-drag', alt: 'A linked run held mid-drag on iPad' }],
      },
    },
    {
      label: 'Note',
      title: 'The same todo, but the note belongs to that day',
      lead: 'The same workbook needs different pages on different days. Tap a selected block once more and a composer docks above the keyboard; what you write there stays with that block only.',
      points: [
        'The keyboard comes up the moment the composer opens. There is no second tap into a note field.',
        'Tapping outside closes it and still saves. There is no path that throws away what you typed.',
        'The top line of the composer is a link to the todo itself, for when you want to change its name or colour.',
        'Notes show inside the block under the title — the taller the block, the more lines you see.',
      ],
      shots: {
        iphone: [{ file: 'memo', alt: 'The note composer docked above the keyboard' }],
        ipad: [{ file: 'memo', alt: 'The note composer docked above the keyboard on iPad' }],
      },
    },
    {
      label: 'Drawer',
      title: 'What you did not get to does not have to be deleted',
      lead: 'Deleting what you missed loses the record, and leaving it in place lets yesterday fill up today. Drag a block onto the drawer in the bottom right and it leaves the timeline with everything about it intact.',
      points: [
        'Its note and its alarm settings are kept. Blocks parked together stay one row, and they come back out spaced exactly as they went in.',
        'Tap a row and it lands in the middle of the day you are looking at. Swipe it instead to pick a date and a time.',
        'Each row says when it went in, and anything older than a week turns orange, so what has been sitting there stands out.',
        'Deleting from the drawer brings up an undo right below it, so there is no confirmation dialog and no mistake that sticks.',
      ],
      shots: {
        iphone: [{ file: 'drawer', alt: 'The drawer sheet: one row for a bundle parked together, one for a single block' }],
        ipad: [{ file: 'drawer', alt: 'The drawer sheet on iPad' }],
      },
    },
    {
      label: 'Track',
      title: 'The record writes itself',
      lead: 'A single day on its own never tells you whether it is going well. Here the blocks you finish are the record, and the todo button at the top adds them up, todo by todo.',
      points: [
        'Every todo fills in a grid of the days it ran. Only what you checked off counts, so a day you planned and skipped is not coloured in as one you did.',
        'Opening one todo shows its hours this week, this month and this year, the streak you are on, a calendar of the days it ran, and the notes you left.',
        'Tapping a cell jumps straight to that day in the planner, and a past day you forgot to record can be filled in later.',
        'A todo you have stopped doing is archived — it leaves the list and its past stays readable.',
      ],
      shots: {
        iphone: [
          { file: 'todo-list', alt: 'The todo list: a contribution strip and total hours on every row' },
          { file: 'todo-detail', alt: 'One todo opened: period tiles and the calendar of days it ran' },
        ],
        ipad: [
          { file: 'todo-list', alt: 'The todo list on iPad' },
          { file: 'todo-detail', alt: 'A todo detail on iPad' },
        ],
      },
    },
    {
      label: 'Profiles',
      title: 'Everyone\'s day stays their own',
      lead: 'When you look after more than one child, or plan work and home side by side, it gets hard to tell whose plan is whose. Profiles split them: the screen only shows the todos and blocks of the profile you are in.',
      points: [
        'Each profile keeps its own todos and its own history. The avatar at the top right switches between them in a tap.',
        'Which profile is open is remembered per device, so a child\'s iPad can show only that child\'s plan.',
        'A profile you no longer use can be archived: its history stays, its alarms stop, and it can be restored later.',
        'Devices on the same Apple Account line up over iCloud. There is no account to make for this app and no sign-in screen.',
      ],
      shots: {
        iphone: [{ file: 'profiles', alt: 'The profile sheet: switching between personal, work and home' }],
        ipad: [{ file: 'profiles', alt: 'The profile sheet on iPad' }],
      },
    },
    {
      label: 'View',
      title: 'The calendar unfolds, and the night goes dark',
      lead: 'Open the date strip and the week becomes a month. Days with something planned carry a dot, so the empty ones show up on one screen.',
      points: [
        'You can pick a date with the month open, and moving to another day keeps the hour you were looking at.',
        'Dark mode follows the system setting. Block colours are tuned so the same colour still reads the same on a dark ground.',
        'Two Home Screen widgets — what just ended and what comes next, and one todo\'s contribution grid — show without opening the app.',
      ],
      shots: {
        iphone: [
          { file: 'month', alt: 'The date strip opened into a month' },
          { file: 'dark', alt: 'The day timeline in dark mode' },
        ],
        ipad: [
          { file: 'month', alt: 'The date strip opened into a month on iPad' },
          { file: 'dark', alt: 'The day timeline in dark mode on iPad' },
        ],
      },
    },
  ],
};
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>
  <AppPage
    lang={lang}
    slug="planner"
    app={app}
    copy={copy}
    ipadShot="plain"
    shotSize={{ iphone: [720, 1564], ipad: [720, 960] }}
  />
</BaseLayout>
