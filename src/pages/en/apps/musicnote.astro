---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppPage, { type Copy } from '../../../components/AppPage.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const app = (await getEntry('apps', 'en/musicnote'))!;

const copy: Copy = {
  tagline: 'Practice until the staff reads',
  summary: 'A position you used to count up from do becomes one you read on sight.',
  hero: {
    iphone: 'The moment a ledger-line A is answered — the answer graded green, the question clock stopped (iPhone)',
    ipad: 'The moment a ledger-line A is answered — the answer graded green, the question clock stopped (iPad)',
  },
  tabs: { iphone: 'iPhone', ipad: 'iPad' },
  closing: ['Records and accounts stay on the device.', 'No sign-in needed.'],
  sections: [
    {
      label: 'Range',
      title: 'A range narrow enough to finish',
      lead: 'Practice that starts too wide goes stale within a week. Treble and bass switch on and off separately, and each clef you keep on gets its own reach.',
      points: [
        'Only the clef you actually need stays on, so you drill that one and nothing else.',
        'Ledger lines reach Easy (one line) or Hard (three lines), so notes you are not ready for stay out.',
        'The range you picked is drawn on a staff, and a clef you switched off stays dimmed in place, so you see what you would be choosing before you turn it on.',
        'Turn on Weak spots at the bottom and your weak notes make up 60% of the questions, without you picking them out one by one.',
      ],
      shots: {
        iphone: [
          { file: 'setup', alt: 'Test setup — a preview staff above one card with range, practice stage and question count' },
          { file: 'range', alt: 'The range sheet — an include switch and Easy/Hard reach per clef, with Weak spots at the bottom' },
        ],
        ipad: [
          { file: 'setup', alt: 'Test setup on iPad — the preview staff and the three chosen values' },
          { file: 'range', alt: 'The range sheet on iPad, with clef ranges and Weak spots' },
        ],
      },
    },
    {
      label: 'Stages',
      title: 'Five stages, one hint less each time',
      lead: 'Handed nothing but a row of notes, most people quit within the week. Instead of picking a practice mode, you pick where you are on one ladder — and each stage card plays its own example, so you see what it asks before you choose.',
      steps: [
        ['Read the scale', 'A whole octave from do is shown in order, then one of its notes is asked. The rest of the octave stays faint, so you answer with the path in view.'],
        ['Do-mi-sol', 'Do, mi and sol stacked a third apart — or do, la and fa when the do sits low — then one of them is asked. You learn to skip instead of counting every line.'],
        ['Fewer hints', 'Step 3 lays the ladder out in faint notes; step 4 leaves only the labeled do. What you watched yesterday, you trace yourself today.'],
        ['No hints', 'The last stage leaves one note and nothing else, so whether you can read it shows on the spot.'],
      ],
      shots: {
        iphone: [
          { file: 'stages', alt: 'The practice stage sheet — five stages from Read the scale to Test with no hints, each with an example staff' },
          { file: 'ladder-hint', alt: 'A question at the ladder-hint stage, with do and mi laid faintly under the note' },
        ],
        ipad: [
          { file: 'stages', alt: 'The practice stage sheet on iPad' },
          { file: 'ladder-hint', alt: 'A question with a faint ladder hint on iPad' },
        ],
      },
    },
    {
      label: 'Session',
      title: 'A session with a set length',
      lead: 'Without an end in sight a session is hard to start, and without any end you never get to say you finished one.',
      points: [
        'Pick 10, 20, 30, 40 or 50 questions. On days you do not want an end, No end at the bottom of the list keeps going.',
        'A right answer sounds its own pitch and a wrong one sounds no pitch at all. The right answer is never spelled out, so you read the note again instead of copying a name.',
        'A wrong answer does not eat into the goal. Only right answers count.',
        'Reach the goal and the Save Record sheet comes up on its own. Pick who it is saved to, tap Play Again, and the next session starts with the same settings.',
      ],
      shots: {
        iphone: [
          { file: 'session-length', alt: 'The question count sheet, from 10 questions to No end' },
          { file: 'hero', alt: 'The moment a question is answered — graded green, with the progress bar' },
          { file: 'save-account', alt: 'The Save Record sheet — a save switch, Save To, and a Play Again button' },
        ],
        ipad: [
          { file: 'session-length', alt: 'The question count sheet on iPad' },
          { file: 'hero', alt: 'A question answered on iPad' },
          { file: 'save-account', alt: 'The Save Record sheet on iPad' },
        ],
      },
    },
    {
      label: 'Stats',
      title: 'Stats that build up note by note',
      lead: 'One accuracy figure does not tell you what to work on. The Stats tab talks about one note at a time.',
      points: [
        'Each position on the staff map has its own colour, so a weak register shows up in the shape you actually read.',
        'Tap a note and the panel below switches to it. Accuracy and speed are graded separately, so a note you get right but slowly shows up too.',
        'The thresholds are written out as numbers behind the ? button, so you never have to guess what a colour means.',
        'Practice these next lines up your weakest notes, and Practice these notes sets up a range built around them.',
        'Only your last 20 sessions count, so what you could not read months ago does not weigh on today.',
      ],
      shots: {
        iphone: [{ file: 'stats-map', alt: 'The staff map coloured green, amber and red, with the chosen note’s accuracy and speed chips, its time trend, and the notes to practise next' }],
        ipad: [{ file: 'stats-map', alt: 'The staff map and note panel on iPad, with the notes to practise next' }],
      },
    },
    {
      label: 'Records',
      title: 'One row per session',
      lead: 'Whether you are improving is not something you can feel. The Records tab groups sessions by day and leaves one row for each.',
      points: [
        'Each row carries the time, how long it took, the type, and the score with a bar on the right, so last session sits next to this one.',
        'Open a row to see every question and how long it took, so you can point to the note that cost you time.',
        'Practice the same types again starts a new session with that session’s settings, so you are not setting it up again.',
        'Averages count first-try answers only, and a session you stopped early is still kept, marked Stopped early.',
        'Records are kept per name, so several people on one device do not end up in one history.',
      ],
      shots: {
        iphone: [
          { file: 'sessions', alt: 'Past sessions grouped by day — time, duration, type and score on each row' },
          { file: 'session-detail', alt: 'Session details — the summary, Practice the same types again, and every question' },
        ],
        ipad: [
          { file: 'sessions', alt: 'Past sessions on iPad' },
          { file: 'session-detail', alt: 'Session details and per-question review on iPad' },
        ],
      },
    },
  ],
};
---

<BaseLayout title={`${app.data.title} - ${t('site.title')}`} description={app.data.summary} lang={lang}>
  <AppPage
    lang={lang}
    slug="musicnote"
    app={app}
    copy={copy}
    ipadShot="plain"
    shotSize={{ iphone: [720, 1564], ipad: [720, 960] }}
  />
</BaseLayout>
