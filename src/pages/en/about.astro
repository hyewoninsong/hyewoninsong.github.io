---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getEntry } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const about = (await getEntry('about', 'en'))!;
---

<BaseLayout title={`${t('about.title')} - ${t('site.title')}`} description={about.data.description} lang={lang}>

  <style>
    .animate-reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .animate-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .section-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-primary);
      margin-bottom: 0.75rem;
    }

  </style>

  <!-- ── Header ── -->
  <div class="max-w-5xl w-full mx-auto px-6 pt-24 md:pt-36 pb-16 md:pb-24">
    <div class="max-w-xl animate-reveal">
      <span class="section-label">About</span>
      <h1 class="text-3xl md:text-4xl font-semibold text-text tracking-tight mb-4">
        Hyewon &amp; Insong
      </h1>
      <p class="text-base text-text-sub leading-relaxed">
        A small two-person mobile studio, based in Pangyo, Korea.
      </p>
    </div>
  </div>

  <!-- ── Support ── This page is the App Store support URL; a way to reach us has to be visible. -->
  <section class="py-20 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-xl animate-reveal">
        <span class="section-label">Support</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">Questions and support</h2>
        <p class="text-text-sub leading-relaxed mb-8">
          If something in one of our apps gets in your way, or you want it to work differently,
          write to us. Telling us which app and which screen gets us there faster.
        </p>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href="mailto:contact@hyewoninsong.com" class="text-sm font-medium text-primary hover:underline">contact@hyewoninsong.com</a>
          <a href="/en/privacy" class="text-sm font-medium text-primary hover:underline">Privacy policy →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Next ── -->
  <section class="py-20 px-6 border-t border-border">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-xl animate-reveal">
        <span class="section-label">Next</span>
        <h2 class="text-2xl font-semibold text-text tracking-tight mb-4">What we make, and how</h2>
        <p class="text-text-sub leading-relaxed mb-8">
          The apps we are building now, and a record of how they come together.
        </p>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href="/en/apps" class="text-sm font-medium text-primary hover:underline">See the app →</a>
          <a href="/en/blog" class="text-sm font-medium text-primary hover:underline">Dev blog →</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.08, rootMargin: '0px 0px -24px 0px' }
  );
  document.querySelectorAll('.animate-reveal').forEach(el => observer.observe(el));
</script>
